        <!-- Part20 -->
        <table:Column width="150px"><Label text="Part20"/><table:template><Input value="{Part20}" editable="false"/></table:template></table:Column>
        <!-- <table:Column width="120px"><Label text="Part20 Price"/><table:template><Input value="{part20Price}" editable="false"type="Number"/></table:template></table:Column> -->

    </table:columns>
</table:Table>


                <!-- TABLE -->
        
            </content>

            <!-- FOOTER -->
            <footer>
    <OverflowToolbar>
        <ToolbarSpacer/>
        <Button
            text="Approve"
            type="Accept"
            icon="sap-icon://accept"
            press="onApprove"/>
        <Button
            text="Reject"
            type="Reject"
            icon="sap-icon://decline"
            press="onReject"/>
    </OverflowToolbar>
</footer>

        </Page>
    </App>

</mvc:View>
