<mvc:View controllerName="editmasterdata.controller.AdminGmaComponent"
     xmlns:html="http://www.w3.org/1999/xhtml"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <App>
        <Page>

            <!-- CENTER HEADER -->
            <customHeader>
                <Toolbar>

                    <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            press="onNavBack" />
                    <ToolbarSpacer/>
                    <Title text="GMA Component" level="H2"/>
                    <ToolbarSpacer/>
                </Toolbar>
            </customHeader>

            <content>

                
           

                <!-- TABLE TOOLBAR -->
        <table:Table
    id="modelPartTable"
    rows="{/GMAComponentsSet}"
    visibleRowCount="8"
    enableBusyIndicator="true"
    selectionMode="MultiToggle"
    width="100%">

    <table:columns>

        <!-- Model Code (NON EDITABLE) -->
        <table:Column width="150px">
            <Label text="Model Code"/>
            <table:template>
                <Text text="{Models}"/>
            </table:template>
        </table:Column>

        <!-- Description -->
        <table:Column width="220px">
            <Label text="Description"/>
            <table:template>
                <Input value="{Description}" editable="false"/>
            </table:template>
        </table:Column>

        <!-- MTS/MTO -->
        <table:Column width="120px">
            <Label text="MTS/MTO"/>
            <table:template>
                <Input value="{MtsMto}" editable="true"/>
            </table:template>
        </table:Column>

        <!-- Reference Model -->
        <table:Column width="180px">
            <Label text="Reference MTS Model"/>
            <table:template>
                <Input value="{ReferMtsModel}"  editable="false"/>
            </table:template>
        </table:Column>

        <!-- PARTS 1 to 20 -->
        <!-- Repeat pattern -->

        <!-- Part1 -->
        <table:Column width="150px">
            <Label text="Part1"/>
            <table:template><ComboBox
    selectedKey="{Part1}" enabled="false"
    items="{
        path: '/PartsSet'
    }">
    <core:Item
        key="{PartCode}"
        text="{PartCode}" />
</ComboBox></table:template>
        </table:Column>
        <table:Column width="120px">
            <Label text="Part1 Price"/>
            <table:template><Input value="{part1Price}" type="Number" editable="false"/></table:template>
        </table:Column>

        <!-- Part2 -->
        <table:Column width="150px">
