<mvc:View
    controllerName="editmasterdata.controller.AdminPricingComponent"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    displayBlock="true">
    <App>
        <Page>
            <!-- HEADER -->
            <customHeader>
                <Toolbar>
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        press="onNavBack" />
                    <ToolbarSpacer />
                    <Title text="Admin Pricing Component" level="H2"/>
                    <ToolbarSpacer />
                </Toolbar>
            </customHeader>

            <!-- CONTENT -->
            <content>

                <VBox>

                    <Toolbar>
                        <Title text="Master Table" />
                        <ToolbarSpacer />
                    </Toolbar>

                    <table:Table
                        id="AdminPricingComponentTable"
                        rows="{/PricingComponentsSet}"
                        visibleRowCount="8"
                        selectionMode="None"
                        width="100%">

                        <table:columns>

                            <table:Column width="120px">
                                <Label text="Region"/>
                                <table:template>
                                    <Text text="{Region}"/>
                                </table:template>
                            </table:Column>

                            <table:Column width="120px">
                                <Label text="Engine Type"/>
                                <table:template>
                                    <Text text="{EngineType}"/>
                                </table:template>
                            </table:Column>

                            <table:Column width="120px">
                                <Label text="Helmet"/>
                                <table:template>
                                    <Text text="{Helmet}"/>
                                </table:template>
                            </table:Column>

                            <table:Column width="120px">
                                <Label text="Transportation"/>
                                <table:template>
                                    <Text text="{Transportation}"/>
                                </table:template>
                            </table:Column>

                            <table:Column width="160px">
                                <Label text="Other Expenses (>500)"/>
                                <table:template>
                                    <Text text="{OtExpGt500}"/>
                                </table:template>
                            </table:Column>

                            <table:Column width="160px">
                                <Label text="Other Expenses (500)"/>
                                <table:template>
                                    <Text text="{OtExpLt500}"/>
                                </table:template>
                            </table:Column>

                            <table:Column width="120px">
                                <Label text="Helmet Margin"/>
                                <table:template>
                                    <Text text="{HelmetMargin}"/>
                                </table:template>
                            </table:Column>

                            <table:Column width="140px">
                                <Label text="Insurance % Below 350cc"/>
                                <table:template>
                                    <Text text="{InsuranceLe350}"/>
                                </table:template>
                            </table:Column>

                            <table:Column width="140px">
                                <Label text="Insurance % Above 350cc"/>
                                <table:template>
                                    <Text text="{InsuranceGt350}"/>
                                </table:template>
                            </table:Column>

                            <table:Column width="140px">
                                <Label text="TPA-PA Above 350CC"/>
                                <table:template>
                                    <Text text="{TpaPaGt350}"/>
                                </table:template>
                            </table:Column>

                            <table:Column width="140px">
                                <Label text="TPA-PA Below 350CC"/>
                                <table:template>
                                    <Text text="{TpaPaLe350}"/>
                                </table:template>
                            </table:Column>

                            <table:Column width="160px">
                                <Label text="Cleaning  Polishing PDI"/>
                                <table:template>
                                    <Text text="{BuffPdi}"/>
                                </table:template>
                            </table:Column>

                            <table:Column width="120px">
                                <Label text="HSPR Rate"/>
                                <table:template>
                                    <Text text="{HsprRate}"/>
                                </table:template>
                            </table:Column>

                            <table:Column width="160px">
                                <Label text="Number Plate Writing"/>
                                <table:template>
                                    <Text text="{NoPlateWrit}"/>
                                </table:template>
                            </table:Column>

                            <table:Column width="150px">
                                <Label text="Petrol charge 500cc"/>
                                <table:template>
                                    <Text text="{PetrolUpto500}"/>
                                </table:template>
                            </table:Column>

                            <table:Column width="180px">
                                <Label text="Petrol charge above 500cc"/>
                                <table:template>
                                    <Text text="{PetrolGt500}"/>
                                </table:template>
                            </table:Column>

                        </table:columns>

                    </table:Table>

                </VBox>

            </content>

          
            <footer>
    <OverflowToolbar>
        <ToolbarSpacer/>
        <Button
            text="Approve"
            type="Accept"
            icon="sap-icon://accept"
            press="onApprove"/>
        <Button
            text="Reject"
            type="Reject"
            icon="sap-icon://decline"
            press="onReject"/>
    </OverflowToolbar>
</footer>        
        </Page>
    </App>
</mvc:View>