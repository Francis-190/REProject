<mvc:View controllerName="editmasterdata.controller.AdminRtoMaster"
 xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <App>
        <Page>
    <customHeader>
                <Toolbar>
                        <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            press="onNavBack" />
                    <ToolbarSpacer/>
                    <Title text="RTO MASTER" level="H2"/>
                    <ToolbarSpacer/>
                </Toolbar>
            </customHeader>
            <!-- TABLE -->
            <content>

<VBox width="100%" alignItems="Center" >



    <Panel width="95%" class="sapUiResponsiveMargin">

    <headerToolbar>
    <Toolbar>
        <ToolbarSpacer/>
        <Button
            text="Create Row"
            icon="sap-icon://add"
            press="onCreateMasterRow"
            />
    </Toolbar>
</headerToolbar>

        <table:Table
            id="RtoMaterTable"
            rows="{/RtoMasterSet}"
            visibleRowCount="10"
            selectionMode="None"
            width="100%"
            enableBusyIndicator="true">

            <table:columns>

                <table:Column>
                    <Label text="Region"/>
                    <table:template>
                        <Input value="{RegionCode}"/>
                    </table:template>
                </table:Column>

                <table:Column>
                    <Label text="Slab"/>
                    <table:template>
                        <Input type="Number" value="{path:'Slab',  type: 'sap.ui.model.type.Integer'}"/>
                    </table:template>
                </table:Column>

                <table:Column>
                    <Label text="CC Min"/>
                    <table:template>
                         <Input type="Number" value="{ path:'CcMin',  type: 'sap.ui.model.type.Integer'}"/>
                    </table:template>
                </table:Column>

                <table:Column>
                    <Label text="CC Max"/>
                    <table:template>
                        <Input type="Number" value="{path:'CcMax',  type: 'sap.ui.model.type.Integer'}"/>
                    </table:template>
                </table:Column>

                <table:Column>
                    <Label text="Min Range"/>
                    <table:template>
                        <Input type="Number" value="{path:'MinRange',  type: 'sap.ui.model.type.Integer'}"/>
                    </table:template>
                </table:Column>

                <table:Column>
                    <Label text="Max Range"/>
                    <table:template>
                        <Input type="Number" value="{path:'MaxRange',  type: 'sap.ui.model.type.Integer'}"/>
                    </table:template>
                </table:Column>

                <table:Column>
                    <Label text="Perice Value"/>
                    <table:template>
                        <Input  type="Number" value="{PercValue}"/>
                    </table:template>
                </table:Column>

            </table:columns>

        </table:Table>

    </Panel>

</VBox>




            </content>

            <!-- FOOTER -->
            <footer>
                <OverflowToolbar>
                    <ToolbarSpacer/>
                    <Button
                        text="Submit"
                        type="Emphasized"
                        press="onSubmit"/>
                </OverflowToolbar>
            </footer>

        </Page>
    </App>
</mvc:View>
