<mvc:View 
    controllerName="editmasterdata.controller.AdminSelectToEditMasterData"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true">

    <Page enableScrolling="false">
        <customHeader>
            <Toolbar>
                
                <ToolbarSpacer/>
                    <Title text="Master Data Management" level="H2"/>
                    <ToolbarSpacer/>
            </Toolbar>
        </customHeader>

        <content>

            <VBox
                height="100%"
                justifyContent="Center"
                alignItems="Center"
                class="sapUiLargeMarginTop">

                <!-- 🔹 Section Title -->
                <Title 
                    text="Welcome Approver !!"
                    level="H3"
                    class="sapUiMediumMarginBottom"/>

                <HBox 
                    alignItems="Center" 
                    justifyContent="Center" 
                    wrap="Wrap">

                    <Button text="Model Master" type="Emphasized" class="sapUiSmallMargin" press="OnModelMaster"/>
                    <Button text="Pricing Component" type="Emphasized" class="sapUiSmallMargin" press="OnpricingComponent"/>
                    <Button text="Region Master" type="Emphasized" class="sapUiSmallMargin" press="OnregionMaster"/>
                    <Button text="Partcode Master" type="Emphasized" class="sapUiSmallMargin" press="OnpartcodeMaster"/>
                    <Button text="GMA Component" type="Emphasized" class="sapUiSmallMargin" press="OnGMAComponent"/>
                    <Button text="RTO Expence" type="Emphasized" class="sapUiSmallMargin" press="OnRTOExpence"/>
                    <Button text="RTO Master" type="Emphasized" class="sapUiSmallMargin" press="OnRTOMaster"/>

                </HBox>

            </VBox>

        </content>

    </Page>

</mvc:View>