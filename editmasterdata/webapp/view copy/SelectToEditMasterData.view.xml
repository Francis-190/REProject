<mvc:View 
    controllerName="editmasterdata.controller.SelectToEditMasterData"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
    displayBlock="true">

    <Page enableScrolling="false" backgroundDesign="List">

        <customHeader>
            <Toolbar>
                <ToolbarSpacer/>
                <Title text="Master Data Management" level="H2"/>
                <ToolbarSpacer/>
            </Toolbar>
        </customHeader>

        <content>
            <VBox
                height="100%"
                justifyContent="Center"
                alignItems="Center">

                <Panel
                    width="auto"
                    backgroundDesign="Solid"
                    class="sapUiResponsivePadding sapUiLargeMargin"
                    style="border-radius: 12px; box-shadow: 0 4px 24px rgba(0,0,0,0.10); border: 1px solid #e0e0e0; padding: 40px 56px;">

                    <content>
                        <VBox alignItems="Center">

                            <core:Icon
                                src="sap-icon://database"
                                size="2.5rem"
                                color="@sapUiHighlight"
                                class="sapUiSmallMarginBottom"/>

                            <Title
                                text="Master Data Management"
                                level="H2"
                                class="sapUiSmallMarginBottom"
                                textAlign="Center"/>

                            <Text
                                text="Select a module below to view or manage master data records."
                                textAlign="Center"
                                class="sapUiMediumMarginBottom"
                                style="color: #6a6d70; font-size: 0.875rem;"/>

                            <HBox
                                alignItems="Center"
                                justifyContent="Center"
                                wrap="Wrap"
                                class="sapUiSmallMarginTop">

                                <Button
                                    text="Model Master"
                                    type="Emphasized"
                                    icon="sap-icon://product"
                                    class="sapUiSmallMargin"
                                    press="OnModelMaster"/>

                                <Button
                                    text="Pricing Component"
                                    type="Emphasized"
                                    icon="sap-icon://currency"
                                    class="sapUiSmallMargin"
                                    press="OnpricingComponent"/>

                                <Button
                                    text="Region Master"
                                    type="Emphasized"
                                    icon="sap-icon://map"
                                    class="sapUiSmallMargin"
                                    press="OnregionMaster"/>

                                <Button
                                    text="Partcode Master"
                                    type="Emphasized"
                                    icon="sap-icon://bar-code"
                                    class="sapUiSmallMargin"
                                    press="OnpartcodeMaster"/>

                                <Button
                                    text="GMA Component"
                                    type="Emphasized"
                                    icon="sap-icon://building"
                                    class="sapUiSmallMargin"
                                    press="OnGMAComponent"/>

                                <Button
                                    text="RTO Expence"
                                    type="Emphasized"
                                    icon="sap-icon://expense-report"
                                    class="sapUiSmallMargin"
                                    press="OnRTOExpence"/>

                                <Button
                                    text="RTO Master"
                                    type="Emphasized"
                                    icon="sap-icon://fleet-management"
                                    class="sapUiSmallMargin"
                                    press="OnRTOMaster"/>

                            </HBox>

                        </VBox>
                    </content>
                </Panel>

            </VBox>
        </content>

    </Page>

</mvc:View>