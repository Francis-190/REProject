    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <App  >
        <Page  enableScrolling="false" >
            <!-- ================= HEADER ================= -->
            <customHeader>
                <Toolbar>
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        press="onNavBack"
                    />
                    <ToolbarSpacer />
 <Button
            text="Create Row"
            icon="sap-icon://add"
            press="onCreateMasterRow"
            />

                    <Title
                        text="GMA Component"
                        level="H2"
                    />
                    <ToolbarSpacer />
                </Toolbar>

            </customHeader>

            <!-- ================= CONTENT ================= -->
            <content >

            
