                        <!-- ================= BASIC FIELDS ================= -->
                        <table:Column width="150px">
                            <Label text="Model" />
                            <table:template>
                                <Text text="{Models}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="220px">
                            <Label text="Description" />
                            <table:template>
                                <Input value="{Description}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="120px">
                            <Label text="MTS/MTO" />
                            <table:template>
                                <Input value="{MtsMto}" />
                            </table:template>
                        </table:Column>
                        <table:Column width="180px">
                            <Label text="Reference Model" />
                            <table:template>
                                <Input value="{ReferMtsModel}" />
                            </table:template>
                        </table:Column>

                        <!-- ================= PART 1 ================= -->
                        <table:Column width="150px">
                            <Label text="Part1" />
                            <table:template>
                                <ComboBox
                                    selectedKey="{Part1}"
                                    items="{viewModel>/PartsSet}"
                                    change="onPartChange"
                                >
                                <customData>
                                <core:CustomData key="part" value="1"></core:CustomData>
                                </customData>
                                    
                                    <core:Item
                                        key="{viewModel>PartCode}"
                                        text="{viewModel>PartCode}"
                                    />
                                </ComboBox>
                            </table:template>
                        </table:Column>
                        <table:Column width="120px">
                            <Label text="Price1" />
                            <table:template>
                                <Input
                                    value="{part1Price}"
                                    type="Number"
                                />
                            </table:template>
                        </table:Column>

                        <!-- ================= PART 2 ================= -->
                        <table:Column width="150px">
                            <Label text="Part2" />
                            <table:template>
                                <ComboBox
                                    selectedKey="{Part2}"
                                    items="{viewModel>/PartsSet}"
                                    change="onPartChange"
                                >

                                <customData>
                                <core:CustomData key="part" value="2"></core:CustomData>
                                </customData>

                                    <core:Item
                                        key="{viewModel>PartCode}"
                                        text="{viewModel>PartCode}"
                                        
                                    />
                                </ComboBox>
                            </table:template>
                        </table:Column>
                        <table:Column width="120px">
                            <Label text="Price2" />
                            <table:template>
                                <Input
                                    value="{part2Price}"
                                    type="Number"
                                />
                            </table:template>
                        </table:Column>

