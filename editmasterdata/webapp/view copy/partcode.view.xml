<mvc:View
    controllerName="editmasterdata.controller.partcode"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true">
<App>
        <Page>

            <!-- CENTER HEADER -->
            <customHeader>
                <Toolbar>
                        <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            press="onNavBack" />
                    <ToolbarSpacer/>
                    <Title text="Part Code Master" level="H2"/>
                    <ToolbarSpacer/>
                </Toolbar>
            </customHeader>

            <content>

                <!-- TABLE TOOLBAR -->
        
                <VBox>
                                <Toolbar>
                                    <Title text="Master Table" />
                                    <ToolbarSpacer />
                                    <Button
                                        text="Create Row"
                                        icon="sap-icon://add"
                                        press="onCreateMasterRow"
                                    />
                                </Toolbar>
                            </VBox>

                <!-- TABLE -->
<table:Table
    id="partMasterTable"
    rows="{/PartsSet}"
    visibleRowCount="8"
    enableBusyIndicator="true"
    selectionMode="None"
    width="100%">

    <table:columns>

        <!-- Family (NON EDITABLE) -->
        <table:Column width="120px">
            <Label text="Family"/>
            <table:template>
                <Input value="{Family}"/>
            </table:template>
        </table:Column>

        <!-- Part Code (NON EDITABLE) -->
        <table:Column width="150px">
            <Label text="Part code"/>
            <table:template>
                <Input value="{PartCode}"/>
            </table:template>
        </table:Column>

        <!-- Description (NON EDITABLE) -->
        <table:Column width="250px">
            <Label text="Description"/>
            <table:template>
                <Input value="{PartDescr}"/>
            </table:template>
        </table:Column>

        <!-- OE/GMA/GMA OE (Editable) -->
        <table:Column width="160px">
            <Label text="OE/GMA/GMA OE"/>
            <table:template>
            <Input value="{OeGma}"/>
            </table:template>
        </table:Column>

        <!-- MRP (Editable) -->
        <table:Column width="120px">
            <Label text="MRP"/>
            <table:template>
                <Input  type ="Number" value="{Mrp}" />
            </table:template>
        </table:Column>

        <!-- MiY Cost (Editable) -->
        <table:Column width="120px">
            <Label text="MiY Cost"/>
            <table:template>
                <Input value="{path:'MiyCost', type:'sap.ui.model.type.Integer'}" type="Number"/>
            </table:template>
        </table:Column>

        <!-- MiY Markup (Editable) -->
        <table:Column width="120px">
            <Label text="MiY Markup"/>
            <table:template>
                <Input type="Number" value="{MiyMarkup}"/>
            </table:template>
        </table:Column>

        <!-- Ex showroom / On Road -->
        <table:Column width="180px">
            <Label text="Ex showroom / On Road"/>
            <table:template>
             <Input value="{ExShowOnRoad}" />
            </table:template>
        </table:Column>

        <!-- MiY Cost % -->
        <table:Column width="120px">
            <Label text="MiY Cost %"/>
            <table:template>
              <Input type="Number" value="{MiyCostPerc}"></Input>
            </table:template>
        </table:Column>

        <!-- MiY Markup % -->
        <table:Column width="140px">
            <Label text="MiY Markup %"/>
            <table:template>
                <Input type="Number" value="{MiyMarkupPerc}"/>
            </table:template>
        </table:Column>

        <!-- Inactive -->

    </table:columns>
</table:Table>



            </content>

            <!-- FOOTER -->
            <footer>
                <OverflowToolbar>
                    <ToolbarSpacer/>
                    <Button
                        text="Submit"
                        type="Emphasized"
                        press="onSubmit"/>
                </OverflowToolbar>
            </footer>

        </Page>
    </App>
</mvc:View>
