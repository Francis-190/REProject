<mvc:View
    controllerName="editmasterdata.controller.pricingcomponent"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    displayBlock="true"
>
    <App>
        <Page>
            <customHeader>
                <Toolbar>
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        press="onNavBack"
                    />
                    <ToolbarSpacer />
                    <Title
                        text="pricing Component"
                        level="H2"
                    />
                    <ToolbarSpacer />
                </Toolbar>
            </customHeader>
            <content>
                <IconTabBar expandable="false">
                    <!-- MASTER TABLE TAB -->
                    <items>
                        <IconTabFilter
                            text="Master Table"
                            icon="sap-icon://table-view"
                        >
                            <VBox>
                                <Toolbar>
                                    <Title text="Master Table" />
                                    <ToolbarSpacer />
                                    <Button
                                        text="Create Row"
                                        icon="sap-icon://add"
                                        press="onCreateMasterRow"
                                    />
                                </Toolbar>

                                <table:Table
                                    id="masterTable"
                                    rows="{/PricingComponentsSet}"
                                    visibleRowCount="5"
                                    selectionMode="None"
                                >
                                    <table:columns>
                                        <table:Column width="120px">
                                            <Label text="Region" />
                                            <table:template>
                                                <Input
                                                    value="{Region}"
                                                    editable="{isEditable}"
                                                />
                                            </table:template>
                                        </table:Column>
                                        <table:Column width="120px">
                                            <Label text="Engine Type" />
                                            <table:template>
                                                <Input
                                                    value="{EngineType}"
                                                    editable="{isEditable}"
                                                />
                                            </table:template>
                                        </table:Column>
                                        <table:Column width="120px">
                                            <Label text="Helmet" />
                                            <table:template>
                                                <Input
                                                    type="Number"
                                                    value="{
        path: 'Helmet',
        type: 'sap.ui.model.type.Integer'
    }"
                                                />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="120px">
                                            <Label text="Transportation" />
                                            <table:template>
                                                <Input type="Number"
                                                    value="{
        path: 'Transportation',
        type: 'sap.ui.model.type.Integer'
    }"
                                                />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="160px">
                                            <Label
                                                text="Other Expenses (>500)"
                                            />
                                            <table:template>
                                                <Input type="Number"
                                                    value="{
        path: 'OtExpGt500',
        type: 'sap.ui.model.type.Integer'
    }" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="160px">
                                            <Label
                                                text="Other Expenses (500)"
                                            />
                                            <table:template>
                                                <Input type="Number"
                                                    value="{
        path: 'OtExpLt500',
        type: 'sap.ui.model.type.Integer'
    }" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="120px">
                                            <Label text="Helmet Margin" />
                                            <table:template>
                                                <Input type="Number" value="{
        path: 'HelmetMargin',
        type: 'sap.ui.model.type.Integer'
    }" />
                                            </table:template>
                                        </table:Column>

                                        <table:Column width="120px">
                                            <Label
                                                text="Insurence % Below 350cc"
                                            />
                                            <table:template>
                                                <Input type="Number"
                                                    value="{InsuranceLe350}"
                                                />
                                            </table:template>
                                        </table:Column>
                                        <table:Column width="120px">
                                            <Label
                                                text="Insurence % Above 350cc"
                                            />
                                            <table:template>
                                                <Input type="Number"
                                                    value="{InsuranceGt350}"
                                                />
                                            </table:template>
                                        </table:Column>
                                        <table:Column width="120px">
                                            <Label text="TPA-PA Above350CC" />
                                            <table:template>
                                                <Input type="Number" value="{
        path: 'TpaPaGt350',
        type: 'sap.ui.model.type.Integer'
    }" />
                                            </table:template>
                                        </table:Column>
                                        <table:Column width="120px">
                                            <Label text="TPA-PA Below 350CC" />
                                            <table:template>
                                                <Input type="Number" value="{
        path: 'TpaPaLe350',
        type: 'sap.ui.model.type.Integer'
    }" />
                                            </table:template>
                                        </table:Column>
                                        <table:Column width="120px">
                                            <Label
                                                text="Cleaning and Polishing PDI"
                                            />
                                            <table:template>
                                                <Input type="Number" value="{
        path: 'BuffPdi',
        type: 'sap.ui.model.type.Integer'
    }" />
                                            </table:template>
                                        </table:Column>
                                        <table:Column width="120px">
                                            <Label
                                                text="Cleaning and Polishing PDI"
                                            />
      
                                        </table:Column>
                                        <table:Column width="120px">
                                            <Label text="HSPR Rate" />
                                            <table:template>
                                                <Input type="Number" value="{
        path: 'HsprRate',
        type: 'sap.ui.model.type.Integer'
    }" />
                                            </table:template>
                                        </table:Column>
                                        <table:Column width="120px">
                                            <Label
                                                text="Number Plate Writing"
                                            />
                                            <table:template>
                                                <Input type="Number" value="{
        path: 'NoPlateWrit',
        type: 'sap.ui.model.type.Integer'
    }" />
                                            </table:template>
                                        </table:Column>
                                        <table:Column width="120px">
                                            <Label text="Petrol charge 500cc" />
                                            <table:template>
                                                <Input type="Number"
                                                    value="{
        path: 'PetrolUpto500',
        type: 'sap.ui.model.type.Integer'
    }"
                                                />
                                            </table:template>
                                        </table:Column>
                                        <table:Column width="120px">
                                            <Label
                                                text="Petrol charge above 500cc"
                                            />
                                            <table:template>
                                                <Input type="Number" value="{
        path: 'PetrolGt500',
        type: 'sap.ui.model.type.Integer'
    }" />
                                            </table:template>
                                        </table:Column>
                                    </table:columns>
                                </table:Table>
                            </VBox>
                        </IconTabFilter>

                        <!-- HISTORY TABLE TAB -->
                    </items>
                </IconTabBar>
            </content>

            <!-- FOOTER -->
            <footer>
                <OverflowToolbar>
                    <ToolbarSpacer />
                    <Button
                        text="Submit"
                        type="Emphasized"
                        press="onSubmit"
                    />
                </OverflowToolbar>
            </footer>
        </Page>
    </App>
</mvc:View>
