<mvc:View
    controllerName="editmasterdata.controller.regionmaster"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <App>
        <Page>
    <customHeader>
                <Toolbar>
                        <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            press="onNavBack" />
                    <ToolbarSpacer/>
                    <Title text="Region Master" level="H2"/>
                    <ToolbarSpacer/>
                </Toolbar>
            </customHeader>
            <!-- TABLE -->
            <content>

<VBox width="100%" alignItems="Center" >



    <Panel width="95%" class="sapUiResponsiveMargin">

    <headerToolbar>
    <Toolbar>
        <ToolbarSpacer/>
        <Button
            text="Create Row"
            icon="sap-icon://add"
            press="onCreateMasterRow"
            />
    </Toolbar>
</headerToolbar>

        <table:Table
            id="regionTables"
            rows="{/RegionMasterSet}"
            visibleRowCount="10"
            selectionMode="Single"
            width="100%"
            enableBusyIndicator="true">

            <table:columns>

                <table:Column>
                    <Label text="Region"/>
                    <table:template>
                        <Input value="{Region}"/>
                    </table:template>
                </table:Column>

                <table:Column>
                    <Label text="Description"/>
                    <table:template>
                        <Input value="{Ort01}"/>
                    </table:template>
                </table:Column>

                   <table:Column>
                    <Label text="Language"/>
                    <table:template>
                        <Input value="{Spras}"/>
                    </table:template>
                </table:Column>

                <table:Column>
                    <Label text="Basis for RTO"/>
                    <table:template>
                        <!-- <ComboBox selectedKey="{BasisRto}">
                            <core:Item key="Basic" text="Basic"/>
                            <core:Item key="Exshowroom" text="Exshowroom"/>
                        </ComboBox> -->
                         <Input value="{BasisRto}"/>
                    </table:template>
                </table:Column>

            </table:columns>
        </table:Table>
    </Panel>
</VBox>
            </content>

            <!-- FOOTER -->
            <footer>
                <OverflowToolbar>
                    <ToolbarSpacer/>
                    <Button
                        text="Submit"
                        type="Emphasized"
                        press="onSubmit"/>
                </OverflowToolbar>
            </footer>

        </Page>
    </App>

</mvc:View>
