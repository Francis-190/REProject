<mvc:View controllerName="editmasterdata.controller.rtoexpence"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <App>
        <Page>
            <customHeader>
                <Toolbar>
                        <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            press="onNavBack" />
                    <ToolbarSpacer />
                    <Title text="RTO Expence" level="H2" />
                    <ToolbarSpacer />
                </Toolbar>
            </customHeader>
            <!-- TABLE -->
            <content>
                <VBox width="100%" alignItems="Center">
                    <Panel width="95%" class="sapUiResponsiveMargin">
    <headerToolbar>
    <Toolbar>
        <ToolbarSpacer/>
        <Button
            text="Create Row"
            icon="sap-icon://add"
            press="onCreateMasterRow"
            />
    </Toolbar>
</headerToolbar>
                        <table:Table
                            id="regionTable"
                            rows="{/RTOExpenseSet}"
                            visibleRowCount="10"
                            selectionMode="Single"
                            width="100%"
                            enableBusyIndicator="true">
                            <table:columns>
                                <table:Column>
                                    <Label text="Region" />
                                    <table:template>
                                        <Text text="{RegionCode}" />
                                    </table:template>
                                </table:Column>
                                <table:Column>
                                    <Label text="Min Range" />
                                    <table:template>
                                        <Text text="{MinRange}" />
                                    </table:template>
                                </table:Column>
                                <table:Column>
                                    <Label text="Max Range" />
                                    <table:template>
                                        <Input value="{MaxRange}" />
                                    </table:template>
                                </table:Column>
                                <table:Column>
                                    <Label text="Expence" />
                                    <table:template>
                                        <Input value="{Expense}" />
                                    </table:template>
                                </table:Column>
                            </table:columns>
                        </table:Table>
                    </Panel>
                </VBox>
            </content>
            <!-- FOOTER -->
            <footer>
                <OverflowToolbar>
                    <ToolbarSpacer />
                    <Button
                        text="Submit"
                        type="Emphasized"
                        press="onSubmit" />
                </OverflowToolbar>
            </footer>
        </Page>
    </App>
</mvc:View>