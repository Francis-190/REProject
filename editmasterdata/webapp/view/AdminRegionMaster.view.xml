<mvc:View
    controllerName="editmasterdata.controller.AdminRegionMaster"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <App>
        <Page>
            <customHeader>
                <Toolbar>
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        press="onNavBack"
                    />
                    <ToolbarSpacer />
                    <Title
                        text="Admin Region Master"
                        level="H2"
                    />
                    <ToolbarSpacer />

                    <Button
                        id="downloadExcelBtn"
                        text="Download"
                        icon="sap-icon://download"
                        type="Ghost"
                        tooltip="Download options"
                        press="onDownloadMenuPress"
                    />
                </Toolbar>
            </customHeader>
            <!-- TABLE -->
            <content>
                <VBox
                 
                >
                    <!-- <headerToolbar>
    <Toolbar>
        <ToolbarSpacer/>
        <Button
            text="Create Row"
            icon="sap-icon://add"
            press="onCreateMasterRow"
            />
    </Toolbar>
</headerToolbar> -->

                        <table:Table
                            id="regionTables"
                            rows="{/RegionMasterSet}"
                            visibleRowCount="14"
                            selectionMode="None"
                            width="100%"
                            enableBusyIndicator="true"
                        >
                            <table:columns>
                                <table:Column>
                                    <Label text="Region" />
                                    <table:template>
                                        <Text text="{Region}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label text="Description" />
                                    <table:template>
                                        <Text text="{Ort01}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label text="EngineType" />
                                    <table:template>
                                        <Text text="{EngineType}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label
                                        text="Effective Date"
                                        tooltip="Effective Date"
                                    />
                                    <table:template>
                                        <Text
                                            text="{
            path: 'FromDate',
            formatter: '.formatDate'
        }"
                                        />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label text="Basis for RTO" />
                                    <table:template>

                                        <Text text="{BasisRto}" />
                                    </table:template>
                                    
                                </table:Column>

                                 <table:Column>
                                    <Label text="Language" />
                                    <table:template>

                                        <Text text="{Spras}" />
                                    </table:template>
                                    
                                </table:Column>

                                
                            </table:columns>
                        </table:Table>
                   
                </VBox>
            </content>

            <!-- FOOTER -->
            <footer>
                <OverflowToolbar>
                    <ToolbarSpacer />
                   <Button
                        text="Approve"
                        type="Accept"
                        enabled="{user>/isApprover}"
                        icon="sap-icon://accept"
                        press="onApprove"
                    />
                    <Button
                        text="Reject"
                        type="Reject"
                         enabled="{user>/isApprover}"
                        icon="sap-icon://decline"
                        press="onReject"
                    />
                </OverflowToolbar>
            </footer>
            <dependents>
                <ActionSheet
                    id="downloadActionSheet"
                    title="Download Options"
                    showCancelButton="true"
                    cancelButtonText="Cancel"
                >
                    <Button
                        text="Download All Data"
                        icon="sap-icon://download"
                        press="onExcelDownloadAll"
                    />

                    <Button
                        text="Select Fields &amp; Download"
                        icon="sap-icon://table-column"
                        press="onExcelDownload"
                    />
                </ActionSheet>

                <Dialog
                    id="fieldSelectDialog"
                    title="Select Fields to Download"
                    contentWidth="250px"
                >
                    <List
                        id="fieldList"
                        mode="MultiSelect"
                        includeItemInSelection="true"
                        items="{fields>/fields}"
                    >
                        <StandardListItem title="{fields>label}" />
                    </List>

                    <beginButton>
                        <Button
                            text="Download"
                            type="Emphasized"
                            press="onDownloadSelectedFields"
                        />
                    </beginButton>

                    <endButton>
                        <Button
                            text="Cancel"
                            press="onCancelDownload"
                        />
                    </endButton>
                </Dialog>
            </dependents>
        </Page>
    </App>
</mvc:View>
