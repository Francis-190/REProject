<mvc:View
    controllerName="editmasterdata.controller.AdminRtoMaster"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <App>
        <Page>
            <customHeader>
                <Toolbar>
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        press="onNavBack"
                    />
                    <ToolbarSpacer />
                    <Title
                        text="RTO MASTER"
                        level="H2"
                    />
                    <ToolbarSpacer />
                    <Button
                        id="downloadExcelBtn"
                        text="Download"
                        icon="sap-icon://download"
                        type="Ghost"
                        tooltip="Download options"
                        press="onDownloadMenuPress"
                    />
                </Toolbar>
            </customHeader>
            <!-- TABLE -->
            <content>
                <VBox
                    width="100%"
                    alignItems="Center"
                >
                  
                     

                        <table:Table
                            id="RtoMaterTable"
                            rows="{/RtoMasterSet}"
                            visibleRowCount="14"
                            selectionMode="None"
                            width="100%"
                            enableBusyIndicator="true"
                        >
                            <table:columns>
                                <table:Column>
                                    <Label text="Region" />
                                    <table:template>
                                        <Text text="{RegionCode}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label text="Slab" />
                                    <table:template>
                                        <Text text="{Slab}" />
                                    </table:template>
                                </table:Column>

                                <table:Column width="120px">
                                    <Label
                                        text="Effective Date"
                                        tooltip="Effective Date"
                                    />
                                    <table:template>
                                        <Text
                                            text="{
            path: 'FromDate',
            formatter: '.formatDate'
        }"
                                        />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label text="CC Min" />
                                    <table:template>
                                        <Text text="{CcMin}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label text="CC Max" />
                                    <table:template>
                                        <Text text="{CcMax}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label text="Min Range" />
                                    <table:template>
                                        <Text text="{MinRange}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label text="Max Range" />
                                    <table:template>
                                        <Text text="{MaxRange}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label text="RTO %" />
                                    <table:template>
                                        <Text text="{RtoPercent}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label text="RTO Value" />
                                    <table:template>
                                        <Text text="{PriceValue}" />
                                    </table:template>
                                </table:Column>
                            </table:columns>
                        </table:Table>
                   
                </VBox>
            </content>

            <!-- FOOTER -->
            <footer>
                <OverflowToolbar>
                    <ToolbarSpacer />
                   <Button
                        text="Approve"
                        type="Accept"
                        enabled="{user>/isApprover}"
                        icon="sap-icon://accept"
                        press="onApprove"
                    />
                    <Button
                        text="Reject"
                        type="Reject"
                         enabled="{user>/isApprover}"
                        icon="sap-icon://decline"
                        press="onReject"
                    />
                </OverflowToolbar>
            </footer>
            <dependents>
                <ActionSheet
                    id="downloadActionSheet"
                    title="Download Options"
                    showCancelButton="true"
                    cancelButtonText="Cancel"
                >
                    <Button
                        text="Download All Data"
                        icon="sap-icon://download"
                        press="onExcelDownloadAll"
                    />

                    <Button
                        text="Select Fields &amp; Download"
                        icon="sap-icon://table-column"
                        press="onExcelDownload"
                    />
                </ActionSheet>

                <Dialog
                    id="fieldSelectDialog"
                    title="Select Fields to Download"
                    contentWidth="250px"
                >
                    <List
                        id="fieldList"
                        mode="MultiSelect"
                        includeItemInSelection="true"
                        items="{fields>/fields}"
                    >
                        <StandardListItem title="{fields>label}" />
                    </List>

                    <beginButton>
                        <Button
                            text="Download"
                            type="Emphasized"
                            press="onDownloadSelectedFields"
                        />
                    </beginButton>

                    <endButton>
                        <Button
                            text="Cancel"
                            press="onCancelDownload"
                        />
                    </endButton>
                </Dialog>
            </dependents>
        </Page>
    </App>
</mvc:View>
