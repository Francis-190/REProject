<mvc:View
    controllerName="editmasterdata.controller.Gmacomponenthistory"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <VBox width="100%" height="100%">

        <!-- ═══════════════════════════════════════════════ -->
        <!--  PAGE HEADER                                    -->
        <!-- ═══════════════════════════════════════════════ -->
        <Toolbar style="Standard" design="Header">
            <Button
                icon="sap-icon://nav-back"
                type="Transparent"
                press="onNavBack" />

            <Image
                src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
                width="130px"
                height="40px"
                class="logoImage" />

            <ToolbarSpacer />

            <Title
                text="GMA Component — History"
                class="textHeaderTitle"
                level="H2" />

            <ToolbarSpacer />
        </Toolbar>

        <Bar ></Bar>

        <!-- ═══════════════════════════════════════════════ -->
        <!--  FILTER BAR                                     -->
        <!-- ═══════════════════════════════════════════════ -->
        <Toolbar>
            <Label text="Model" class="sapUiTinyMarginEnd" />
            <MultiComboBox
                id="filterModelCode"
                width="220px"
                class="sapUiTinyMarginEnd"
                items="{filter>/Models}">
                <core:Item key="{filter>Models}" text="{filter>Models}" />
            </MultiComboBox>

            <Button
                text="Filter"
                icon="sap-icon://filter"
                type="Emphasized"
                class="sapUiTinyMarginEnd"
                press="onApplyFilter" />

            <Button
                text="Clear"
                icon="sap-icon://clear-filter"
                type="Default"
                press="onClearFilter" />

            <ToolbarSpacer />
        </Toolbar>

        <Bar ></Bar>


        <table:Table
            id="gmaTable"
            visibleRowCount="12"
            selectionMode="None"
            width="100%"
            enableBusyIndicator="true"
            columnHeaderHeight="36"
            rowHeight="32"
          
            rowsUpdated="onRowsUpdated">

            <table:rowSettingsTemplate>
                            <table:RowSettings
                                highlight="{
                                    path: 'FromDate',
                                    formatter: '.formatRowHighlight'
                                }" />
                        </table:rowSettingsTemplate>

            <table:columns>

                <!-- FIXED 1-7 -->
                <table:Column width="110px" sortProperty="Models">
                    <Label text="Model" />
                    <table:template><Text text="{Models}" /></table:template>
                </table:Column>

                <table:Column width="180px" sortProperty="Description">
                    <Label text="Description" />
                    <table:template><Text text="{Description}"  /></table:template>
                </table:Column>

                <table:Column width="80px" sortProperty="MtsMto">
                    <Label text="MTS/MTO" />
                    <table:template><Text text="{MtsMto}"  /></table:template>
                </table:Column>

                <table:Column width="120px" sortProperty="ReferMtsModel">
                    <Label text="Ref. Model" />
                    <table:template><Text text="{ReferMtsModel}" /></table:template>
                </table:Column>

                <table:Column width="100px" sortProperty="FromDate">
                    <Label text="Eff. Date" />
                    <table:template>
                        <Text text="{path: 'FromDate', formatter: '.formatDate'}" wrapping="false" />
                    </table:template>
                </table:Column>

                <table:Column width="100px" sortProperty="Status">
                    <Label text="Status" />
                    <table:template>
                        <ObjectStatus
                            text="{Status}"
                            state="{= ${Status} === 'APPROVED' ? 'Success' : ${Status} === 'REJECTED' ? 'Error' : 'Warning' }" />
                    </table:template>
                </table:Column>

                

                <table:Column width="110px"><Label text="Part 1" /><table:template><Text text="{Part1}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 1" /><table:template><Text text="{Part1Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 2" /><table:template><Text text="{Part2}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 2" /><table:template><Text text="{Part2Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 3" /><table:template><Text text="{Part3}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 3" /><table:template><Text text="{Part3Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 4" /><table:template><Text text="{Part4}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 4" /><table:template><Text text="{Part4Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 5" /><table:template><Text text="{Part5}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 5" /><table:template><Text text="{Part5Price}" wrapping="false" /></table:template></table:Column>

                <table:Column width="110px"><Label text="Part 6" /><table:template><Text text="{Part6}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 6" /><table:template><Text text="{Part6Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 7" /><table:template><Text text="{Part7}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 7" /><table:template><Text text="{Part7Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 8" /><table:template><Text text="{Part8}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 8" /><table:template><Text text="{Part8Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 9" /><table:template><Text text="{Part9}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 9" /><table:template><Text text="{Part9Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 10" /><table:template><Text text="{Part10}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 10" /><table:template><Text text="{Part10Price}" wrapping="false" /></table:template></table:Column>

                <table:Column width="110px"><Label text="Part 11" /><table:template><Text text="{Part11}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 11" /><table:template><Text text="{Part11Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 12" /><table:template><Text text="{Part12}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 12" /><table:template><Text text="{Part12Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 13" /><table:template><Text text="{Part13}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 13" /><table:template><Text text="{Part13Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 14" /><table:template><Text text="{Part14}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 14" /><table:template><Text text="{Part14Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 15" /><table:template><Text text="{Part15}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 15" /><table:template><Text text="{Part15Price}" wrapping="false" /></table:template></table:Column>

                <table:Column width="110px"><Label text="Part 16" /><table:template><Text text="{Part16}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 16" /><table:template><Text text="{Part16Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 17" /><table:template><Text text="{Part17}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 17" /><table:template><Text text="{Part17Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 18" /><table:template><Text text="{Part18}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 18" /><table:template><Text text="{Part18Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 19" /><table:template><Text text="{Part19}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 19" /><table:template><Text text="{Part19Price}" wrapping="false" /></table:template></table:Column>
                <table:Column width="110px"><Label text="Part 20" /><table:template><Text text="{Part20}" wrapping="false" /></table:template></table:Column>
                <table:Column width="75px"><Label text="Price 20" /><table:template><Text text="{Part20Price}" wrapping="false" /></table:template></table:Column>

                <table:Column width="160px" sortProperty="Message">
                    <Label text="Message" />
                    <table:template><Text text="{Message}" wrapping="false" /></table:template>
                </table:Column>

            </table:columns>
        </table:Table>

    </VBox>

</mvc:View>