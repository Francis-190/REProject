<mvc:View
    controllerName="editmasterdata.controller.History"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    displayBlock="true">
 
    <Page
        id="historyPage"
        enableScrolling="true"
        backgroundDesign="Standard"
        showHeader="true" class="masterBg">
 
   <customHeader>
    <Toolbar>

        <!-- Left side -->
        <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            press="onNavBack" />

        <Image
            src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
            width="130px"
            height="40px"
            class="logoImage" />

        <!-- Push everything after this to right -->
        <ToolbarSpacer />

        <!-- Right side -->
        <ObjectStatus
            text="History Data View"
            state="Information"
            icon="sap-icon://person-placeholder"
        />

        <Button
            icon="sap-icon://account"
            type="Transparent"
            tooltip="User Profile"
            press="onUserPress"/>

    </Toolbar>
</customHeader>
 
        <content>
            <l:VerticalLayout width="100%" class="sapUiResponsivePadding">
 
                <!-- HERO SECTION -->
                <FlexBox
                    justifyContent="Center"
                    alignItems="Center"
                    direction="Column"
                    class="sapUiTinyMarginTop sapUiMediumMarginBottom heroSection"  >
 
      <core:Icon
                        src="sap-icon://database"
                        size="3rem"
                        color="@sapUiHighlight"
                        class="sapUiSmallMarginBottom"/>
 
                    <Title
                        text="History Records"
                        level="H1"
                        titleStyle="H2"
                        textAlign="Center"
                        class="sapUiSmallMarginBottom" />
 
                    <Text
                        text="Select a module below to view historical master data records (read-only)."
                        textAlign="Center"
                        wrapping="true"
                        class="sapUiMediumMarginBottom" />
 
                </FlexBox>
 
                <!-- TILE ROW 1 -->
                <FlexBox
                    justifyContent="Center"
                    alignItems="Stretch"
                    wrap="Wrap"
                    class="sapUiResponsiveMargin">
 
                    <GenericTile
                        header="Model Master"
                        subheader="Products &amp; Configurations"
                        tileSizeBehavior="Responsive"
                        frameType="OneByOne"
                        press="onHistoryModelMaster"
                        scope="Display"
                        state="Loaded"
                        class="sapUiSmallMargin masterTile">
                        <tileContent>
                            <TileContent label="View History">
                                <content>
                                    <ImageContent src="sap-icon://product" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
 
                    <GenericTile
                        header="Pricing Component"
                        subheader="Rates &amp; Price Structures"
                        tileSizeBehavior="Responsive"
                        frameType="OneByOne"
                        press="onHistoryPricingComponent"
                        scope="Display"
                        state="Loaded"
                        class="sapUiSmallMargin masterTile">
                        <tileContent>
                            <TileContent label="View History">
                                <content>
                                    <ImageContent src="sap-icon://currency" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
 
                    <GenericTile
                        header="Region Master"
                        subheader="Geographic Zones &amp; Mapping"
                        tileSizeBehavior="Responsive"
                        frameType="OneByOne"
                        press="onHistoryRegionMaster"
                        scope="Display"
                        state="Loaded"
                        class="sapUiSmallMargin masterTile">
                        <tileContent>
                            <TileContent label="View History">
                                <content>
                                    <ImageContent src="sap-icon://map" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
 
                    <GenericTile
                        header="Partcode Master"
                        subheader="SKUs &amp; Part References"
                        tileSizeBehavior="Responsive"
                        frameType="OneByOne"
                        press="onHistoryPartcodeMaster"
                        scope="Display"
                        state="Loaded"
                        class="sapUiSmallMargin masterTile">
                        <tileContent>
                            <TileContent label="View History">
                                <content>
                                    <ImageContent src="sap-icon://bar-code" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
 
                </FlexBox>
 
                <!-- TILE ROW 2 -->
                <FlexBox
                    justifyContent="Center"
                    alignItems="Stretch"
                    wrap="Wrap"
                    class="sapUiResponsiveMargin">
 
                    <GenericTile
                        header="GMA Component"
                        subheader="Gross Margin Adjustments"
                        tileSizeBehavior="Responsive"
                        frameType="OneByOne"
                        press="onHistoryGMAComponent"
                        scope="Display"
                        state="Loaded"
                        class="sapUiSmallMargin masterTile">
                        <tileContent>
                            <TileContent label="View History">
                                <content>
                                    <ImageContent src="sap-icon://building" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
 
                    <GenericTile
                        header="RTO Expense"
                        subheader="Expense Tracking &amp; Control"
                        tileSizeBehavior="Responsive"
                        frameType="OneByOne"
                        press="onHistoryRTOExpense"
                        scope="Display"
                        state="Loaded"
                        class="sapUiSmallMargin masterTile">
                        <tileContent>
                            <TileContent label="View History">
                                <content>
                                    <ImageContent src="sap-icon://expense-report" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
 
                    <GenericTile
                        header="RTO Master"
                        subheader="RTO Office &amp; Registration Data"
                        tileSizeBehavior="Responsive"
                        frameType="OneByOne"
                        press="onHistoryRTOMaster"
                        scope="Display"
                        state="Loaded"
                        class="sapUiSmallMargin masterTile">
                        <tileContent>
                            <TileContent label="View History">
                                <content>
                                    <ImageContent src="sap-icon://crm-service-manager" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
 
                </FlexBox>
 
            </l:VerticalLayout>
        </content>
 
        <footer>
            <OverflowToolbar class="masterFooter">
                <ToolbarSpacer />
                <Text text="History Records — Read Only" />
                <ToolbarSpacer />
            </OverflowToolbar>
        </footer>
 
    </Page>
 
</mvc:View>