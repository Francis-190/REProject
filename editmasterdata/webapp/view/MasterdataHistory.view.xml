<mvc:View
    controllerName="editmasterdata.controller.MasterdataHistory"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <Page enableScrolling="true">
        <customHeader>
            <Toolbar>
                <Button
                    icon="sap-icon://nav-back"
                    type="Transparent"
                    press="onNavBack"
                />

                <Image
                    src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
                    width="130px"
                    height="40px"
                    class="logoImage"
                />

                <ToolbarSpacer />

                <Title
                    text="Model Master — History"
                    class="textHeaderTitle"
                    level="H2"
                />

                <ToolbarSpacer />
            </Toolbar>
        </customHeader>

        <content>
            <VBox class="sapUiSmallMarginTop">
                <Toolbar>
                    <HBox
                        alignItems="Center"
                        renderType="Bare"
                    >
                        <Label
                            text="Model Code"
                            class="sapUiTinyMarginEnd"
                        />
                        <MultiComboBox
                            id="filterModelCode"
                            width="220px"
                            class="sapUiTinyMarginEnd"
                            items="{filter>/Models}"
                        >
                            <core:Item
                                key="{filter>ModelCode}"
                                text="{filter>Display}"
                            />
                        </MultiComboBox>

                        <Label
                            text="Engine Type"
                            class="sapUiTinyMarginBegin sapUiTinyMarginEnd"
                        />
                        <MultiComboBox
                            id="filterEngineType"
                            width="180px"
                            class="sapUiTinyMarginEnd"
                            items="{filter>/EngineType}"
                        >
                            <core:Item
                                key="{filter>EngineType}"
                                text="{filter>EngineType}"
                            />
                        </MultiComboBox>

                        <Label
                            text="CC/Watt"
                            class="sapUiTinyMarginBegin sapUiTinyMarginEnd"
                        />
                        <MultiComboBox
                            id="filterCcType"
                            width="180px"
                            class="sapUiTinyMarginEnd"
                            items="{filter>/CcWatt}"
                        >
                            <core:Item
                                key="{filter>Ccwatt}"
                                text="{filter>Ccwatt}"
                            />
                        </MultiComboBox>

                        <Label
                            text="Family"
                            class="sapUiTinyMarginBegin sapUiTinyMarginEnd"
                        />
                        <MultiComboBox
                            id="filterFamilyType"
                            width="180px"
                            class="sapUiTinyMarginEnd"
                            items="{filter>/ModelFam}"
                        >
                            <core:Item
                                key="{filter>ModelFam}"
                                text="{filter>ModelFam}"
                            />
                        </MultiComboBox>
                    </HBox>

                    <Button
                        text="Filter"
                        icon="sap-icon://filter"
                        class="sapUiTinyMarginEnd"
                        type="Emphasized"
                        press="onApplyFilter"
                    />

                    <Button
                        text="Clear"
                        icon="sap-icon://clear-filter"
                        type="Emphasized"
                        press="onClearFilter"
                    />
                </Toolbar>
            </VBox>

            <Bar />

            <table:Table
                id="modelTable"
                width="100%"
                rows="{ path: '/ModelMasterSet' }"
                visibleRowCount="11"
                visibleRowCountMode="Fixed"
                selectionMode="None"
                rowHeight="40"
                enableBusyIndicator="true"
                rowsUpdated="onRowsUpdated"
            >

            <table:rowSettingsTemplate>
                            <table:RowSettings
                                highlight="{
                                    path: 'FromDate',
                                    formatter: '.formatRowHighlight'
                                }" />
                        </table:rowSettingsTemplate>

                <table:columns>
                    <table:Column width="150px">
                        <Label
                            text="Model Code"
                            tooltip="Model Code"
                        />
                        <table:template>
                            <Text text="{ModelCode}" />
                        </table:template>
                    </table:Column>

                    <table:Column width="150px">
                        <Label
                            text="Engine Type"
                            tooltip="Engine Type"
                        />
                        <table:template>
                            <Text text="{EngineType}" />
                        </table:template>
                    </table:Column>

                    <table:Column width="120px">
                        <Label
                            text="CC/Watt"
                            tooltip="CC/Watt"
                        />
                        <table:template>
                            <Text text="{CcWatt}" />
                        </table:template>
                    </table:Column>

                    <table:Column width="180px">
                        <Label
                            text="Effective Date"
                            tooltip="Effective Date"
                        />
                        <table:template>
                            <Text
                                text="{
            path: 'FromDate',
            formatter: '.formatDate'
        }"
                            />
                        </table:template>
                    </table:Column>

                    <table:Column width="200px">
                        <Label
                            text="Model Type"
                            tooltip="Model Type"
                        />
                        <table:template>
                            <Text text="{OrdType}" />
                        </table:template>
                    </table:Column>

                    <table:Column width="200px">
                        <Label
                            text="Description"
                            tooltip="Description"
                        />
                        <table:template>
                            <Text text="{Description}" />
                        </table:template>
                    </table:Column>

                    <table:Column width="160px">
                        <Label
                            text="Model Family"
                            tooltip="Model Family"
                        />
                        <table:template>
                            <Text text="{ModelFam}" />
                        </table:template>
                    </table:Column>

                    <table:Column width="120px">
                        <Label
                            text="GST%"
                            tooltip="GST%"
                        />
                        <table:template>
                            <Text text="{GstPerc}" />
                        </table:template>
                    </table:Column>

                    <table:Column width="160px">
                        <Label
                            text="Dealer Margin"
                            tooltip="Dealer Margin"
                        />
                        <table:template>
                            <Text text="{DealerMargin}" />
                        </table:template>
                    </table:Column>

                    <table:Column width="200px">
                        <Label
                            text="Dealer Margin Calculation"
                            tooltip="Dealer Margin Calculation"
                        />
                        <table:template>
                            <Text text="{DealerMargCalc}" />
                        </table:template>
                    </table:Column>

                    <table:Column width="200px">
                        <Label
                            text="Dealer Margin Cost Impact"
                            tooltip="Dealer Margin Cost Impact"
                        />
                        <table:template>
                            <Text text="{DealerMargCostImp}" />
                        </table:template>
                    </table:Column>

                    <table:Column width="160px">
                        <Label
                            text="CSD Index Number"
                            tooltip="CSD Index Number"
                        />
                        <table:template>
                            <Text text="{CsdIndex}" />
                        </table:template>
                    </table:Column>

                    <table:Column width="160px">
                        <Label
                            text="CSD Discount Rate %"
                            tooltip="CSD Discount Rate %"
                        />
                        <table:template>
                            <Text text="{CsdDisPerc}" />
                        </table:template>
                    </table:Column>

                    <table:Column width="120px">
                        <Label
                            text="GEM"
                            tooltip="GEM"
                        />
                        <table:template>
                            <Text text="{Gem}" />
                        </table:template>
                    </table:Column>

                    <table:Column width="200px">
                        <Label
                            text="Model Status"
                            tooltip="Model Status"
                        />
                        <table:template>
                            <Text text="{ModelStatus}" />
                        </table:template>
                    </table:Column>

                    <table:Column width="120px">
                        <Label
                            text="Status"
                            tooltip="Status"
                        />
                        <table:template>
                            <Text text="{Status}" />
                        </table:template>
                    </table:Column>
                </table:columns>
            </table:Table>
        </content>
    </Page>
</mvc:View>
