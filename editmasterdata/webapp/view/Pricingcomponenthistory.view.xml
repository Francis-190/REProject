<mvc:View
    controllerName="editmasterdata.controller.Pricingcomponenthistory"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
    displayBlock="true">

    <Page>

        <customHeader>
            <Toolbar>
                <Button
                    icon="sap-icon://nav-back"
                    type="Transparent"
                    press="onNavBack" />

                <Image
                    src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
                    width="130px"
                    height="40px"
                    class="logoImage" />

                <ToolbarSpacer />

                <Title
                    text="Pricing Component — History"
                    class="textHeaderTitle"
                    level="H2" />

                <ToolbarSpacer />
            </Toolbar>
        </customHeader>

        <Bar />

        <content>

            <VBox>

                <Toolbar>

                    <HBox alignItems="Center" renderType="Bare">

                        <Label text="Region" class="sapUiTinyMarginEnd" />
                        <MultiComboBox
                            id="filterModelCode"
                            width="220px"
                            class="sapUiTinyMarginEnd"
                            items="{filter>/Models}">
                            <core:Item key="{filter>Region}" text="{filter>Display}" />
                        </MultiComboBox>

                    </HBox>

                    <Button
                        text="Filter"
                        icon="sap-icon://filter"
                        type="Emphasized"
                        class="sapUiTinyMarginEnd"
                        press="onApplyFilter" />

                    <Button
                        text="Clear"
                        icon="sap-icon://clear-filter"
                        type="Emphasized"
                        press="onClearFilter" />

                    <ToolbarSpacer />

                </Toolbar>

                <Bar />

                <table:Table
                    id="masterTable"
                    rows="{/PricingComponentsSet}"
                    visibleRowCount="12"
                    selectionMode="None"
                    enableBusyIndicator="true"
                    width="100%"
                    rowsUpdated="onRowsUpdated">

                    <table:rowSettingsTemplate>
                            <table:RowSettings
                                highlight="{
                                    path: 'FromDate',
                                    formatter: '.formatRowHighlight'
                                }" />
                        </table:rowSettingsTemplate>

                    <table:columns>

                        <table:Column width="120px">
                            <Label text="Region" tooltip="Region" />
                            <table:template>
                                <Text text="{Region}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="200px">
                            <Label text="Engine Type" tooltip="Engine Type" />
                            <table:template>
                                <Text text="{EngineType}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="180px">
                        <Label
                            text="Effective Date"
                            tooltip="Effective Date"
                        />
                        <table:template>
                            <Text
                                text="{
            path: 'FromDate',
            formatter: '.formatDate'
        }"
                            />
                        </table:template>
                    </table:Column>


                        <table:Column width="120px">
                            <Label text="Helmet Cost" tooltip="Helmet Cost" />
                            <table:template>
                                <Text text="{Helmet}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="120px">
                            <Label text="Transportation" tooltip="Transportation" />
                            <table:template>
                                <Text text="{Transportation}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="160px">
                            <Label text="Other Expenses (+500)" tooltip="Other Expenses (+500)" />
                            <table:template>
                                <Text text="{OtExpGt500}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="160px">
                            <Label text="Other Expenses (-500)" tooltip="Other Expenses (-500)" />
                            <table:template>
                                <Text text="{OtExpLt500}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="120px">
                            <Label text="Helmet Margin" tooltip="Helmet Margin" />
                            <table:template>
                                <Text text="{HelmetMargin}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="180px">
                            <Label text="Insurance% Below 350cc" tooltip="Insurance Below 350cc" />
                            <table:template>
                                <Text text="{InsuranceLe350}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="180px">
                            <Label text="Insurance% Above 350cc" tooltip="Insurance% Above 350cc" />
                            <table:template>
                                <Text text="{InsuranceGt350}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="180px">
                            <Label text="TPA-PA Above 350CC" tooltip="TPA-PA Above 350CC" />
                            <table:template>
                                <Text text="{TpaPaGt350}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="180px">
                            <Label text="TPA-PA Below 350CC" tooltip="TPA-PA Below 350CC" />
                            <table:template>
                                <Text text="{TpaPaLe350}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="190px">
                            <Label text="Cleaning and Polishing PDI" tooltip="Cleaning and Polishing PDI" />
                            <table:template>
                                <Text text="{BuffPdi}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="120px">
                            <Label text="HSPR Rate" tooltip="HSPR Rate" />
                            <table:template>
                                <Text text="{HsprRate}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="180px">
                            <Label text="Number Plate Writing" tooltip="Number Plate Writing" />
                            <table:template>
                                <Text text="{NoPlateWrit}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="190px">
                            <Label text="Petrol Charge Below 500cc" tooltip="Petrol Charge Below 500cc" />
                            <table:template>
                                <Text text="{PetrolUpto500}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="190px">
                            <Label text="Petrol Charge Above 500cc" tooltip="Petrol Charge Above 500cc" />
                            <table:template>
                                <Text text="{PetrolGt500}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="120px">
                            <Label text="RTO Expense" tooltip="RTO Expense" />
                            <table:template>
                                <Text text="{RtoExpense}" />
                            </table:template>
                        </table:Column>

                        <table:Column width="120px">
                            <Label text="Status" tooltip="Status" />
                            <table:template>
                                <Text text="{Status}" />
                            </table:template>
                        </table:Column>

                    </table:columns>
                </table:Table>

            </VBox>

        </content>

    </Page>

</mvc:View>