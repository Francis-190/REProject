<mvc:View
    controllerName="editmasterdata.controller.RegionmasterHistory"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <Page>
        <customHeader>
            <Toolbar>
                <Button
                    icon="sap-icon://nav-back"
                    type="Transparent"
                    press="onNavBack"
                />

                <Image
                    src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
                    width="130px"
                    height="40px"
                    class="logoImage"
                />

                <ToolbarSpacer />

                <Title
                    text="Region Master — History"
                    class="textHeaderTitle"
                    level="H2"
                />

                <ToolbarSpacer />
            </Toolbar>
        </customHeader>

        <content>
            <VBox
                width="100%"
                alignItems="Center"
            >
                <Panel
                    width="95%"
                    class="sapUiResponsiveMargin"
                >
                    <headerToolbar>
                        <Toolbar>
                            <ToolbarSpacer />
                        </Toolbar>
                    </headerToolbar>

                    <VBox class="sapUiSmallMarginTop">
                        <Toolbar>
                            <HBox
                                alignItems="Center"
                                renderType="Bare"
                            >
                                <Label
                                    text="Region Code"
                                    class="sapUiTinyMarginEnd"
                                />
                                <MultiComboBox
                                    id="filterModelCode"
                                    width="220px"
                                    class="sapUiTinyMarginEnd"
                                    items="{filter>/Models}"
                                >
                                    <core:Item
                                        key="{filter>Region}"
                                        text="{filter>Display}"
                                    />
                                </MultiComboBox>
                            </HBox>

                            <Button
                                text="Filter"
                                icon="sap-icon://filter"
                                class="sapUiTinyMarginEnd"
                                type="Emphasized"
                                press="onApplyFilter"
                            />

                            <Button
                                text="Clear"
                                icon="sap-icon://clear-filter"
                                type="Emphasized"
                                press="onClearFilter"
                            />
                        </Toolbar>
                    </VBox>

                    <Bar />

                    <table:Table
                        id="regionTables"
                        rows="{/RegionInvalidSet}"
                        visibleRowCount="12"
                        selectionMode="None"
                        width="100%"
                        enableBusyIndicator="true"
                        rowsUpdated="onRowsUpdated"
                    >
                        <table:rowSettingsTemplate>
                            <table:RowSettings
                                highlight="{
                                    path: 'FromDate',
                                    formatter: '.formatRowHighlight'
                                }"
                            />
                        </table:rowSettingsTemplate>

                        <table:columns>
                            <table:Column>
                                <Label
                                    text="Region"
                                    tooltip="Region"
                                />
                                <table:template>
                                    <Text text="{Region}" />
                                </table:template>
                            </table:Column>

                            <table:Column width="150px">
                                <Label
                                    text="Engine Type"
                                    tooltip="Engine Type"
                                />
                                <table:template>
                                    <Text text="{EngineType}" />
                                </table:template>
                            </table:Column>

                            <table:Column>
                                <Label
                                    text="Description"
                                    tooltip="Description"
                                />
                                <table:template>
                                    <Text text="{Ort01}" />
                                </table:template>
                            </table:Column>

                            <table:Column>
                                <Label
                                    text="Effective Date"
                                    tooltip="Effective Date"
                                />
                                <table:template>
                                    <Text
                                        text="{
            path: 'FromDate',
            formatter: '.formatDate'
        }"
                                    />
                                </table:template>
                            </table:Column>

                            <table:Column>
                                <Label
                                    text="Language"
                                    tooltip="Language"
                                />
                                <table:template>
                                    <Text text="{Spras}" />
                                </table:template>
                            </table:Column>

                            <table:Column>
                                <Label
                                    text="Basic For RTO"
                                    tooltip="Basic For RTO"
                                />
                                <table:template>
                                    <Text text="{BasisRto}" />
                                </table:template>
                            </table:Column>

                            <table:Column width="120px">
                                <Label
                                    text="Status"
                                    tooltip="Status"
                                />
                                <table:template>
                                    <Text text="{Status}" />
                                </table:template>
                            </table:Column>
                        </table:columns>
                    </table:Table>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
