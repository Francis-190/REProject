<mvc:View
    controllerName="editmasterdata.controller.Rtomasterhistory"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <App>
        <Page>
            <customHeader>
                <Toolbar>
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        press="onNavBack"
                    />

                    <Image
                        src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
                        width="130px"
                        height="40px"
                        class="logoImage"
                    />

                    <ToolbarSpacer />

                    <Title
                        text="RTO Master — History"
                        class="textHeaderTitle"
                        level="H2"
                    />

                    <ToolbarSpacer />
                </Toolbar>
            </customHeader>

            <content>
                <VBox
                    width="100%"
                    alignItems="Center"
                >
                    <Panel
                        width="95%"
                        class="sapUiResponsiveMargin"
                    >
                        <headerToolbar>
                            <Toolbar>
                                <ToolbarSpacer />
                            </Toolbar>
                        </headerToolbar>

                        <VBox class="sapUiSmallMarginTop">
                            <Toolbar>
                                <HBox
                                    alignItems="Center"
                                    renderType="Bare"
                                >
                                    <Label
                                        text="Region Code"
                                        class="sapUiTinyMarginEnd"
                                    />
                                    <MultiComboBox
                                        id="filterModelCode"
                                        width="220px"
                                        class="sapUiTinyMarginEnd"
                                        items="{filter>/RegionCode}"
                                    >
                                        <core:Item
                                            key="{filter>RegionCode}"
                                            text="{filter>Display}"
                                        />
                                    </MultiComboBox>

                                    <Label
                                        text="Slab"
                                        class="sapUiTinyMarginEnd"
                                    />
                                    <MultiComboBox
                                        id="filterSlab"
                                        width="220px"
                                        class="sapUiTinyMarginEnd"
                                        items="{filter>/Slab}"
                                    >
                                        <core:Item
                                            key="{filter>Slab}"
                                            text="{filter>Display}"
                                        />
                                    </MultiComboBox>
                                </HBox>

                                <Button
                                    text="Filter"
                                    icon="sap-icon://filter"
                                    type="Emphasized"
                                    class="sapUiTinyMarginEnd"
                                    press="onApplyFilter"
                                />

                                <Button
                                    text="Clear"
                                    icon="sap-icon://clear-filter"
                                    type="Emphasized"
                                    press="onClearFilter"
                                />
                            </Toolbar>
                        </VBox>

                        <Bar />

                        <table:Table
                            id="RtoMaterTable"
                            rows="{/RtoMasterInvalidSet}"
                            visibleRowCount="12"
                            selectionMode="None"
                            width="100%"
                            enableBusyIndicator="true"
                            rowsUpdated="onRowsUpdated"
                        >
                            <table:rowSettingsTemplate>
                                <table:RowSettings
                                    highlight="{
                                    path: 'FromDate',
                                    formatter: '.formatRowHighlight'
                                }"
                                />
                            </table:rowSettingsTemplate>

                            <table:columns>
                                <table:Column>
                                    <Label
                                        text="Region"
                                        tooltip="Region"
                                    />
                                    <table:template>
                                        <Text text="{RegionCode}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label
                                        text="Slab"
                                        tooltip="Slab"
                                    />
                                    <table:template>
                                        <Text text="{Slab}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label
                                        text="Effective Date"
                                        tooltip="Effective Date"
                                    />
                                    <table:template>
                                        <Text
                                            text="{
            path: 'FromDate',
            formatter: '.formatDate'
        }"
                                        />
                                    </table:template>
                                </table:Column>

                                <!-- <table:Column width="150px">
                                    <Label text="Engine Type" tooltip="Engine Type" />
                                    <table:template>
                                        <Text text="{EngineType}" />
                                    </table:template>
                                </table:Column> -->

                                <table:Column>
                                    <Label
                                        text="CC Min"
                                        tooltip="CC Min"
                                    />
                                    <table:template>
                                        <Text text="{CcMin}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label
                                        text="CC Max"
                                        tooltip="CC Max"
                                    />
                                    <table:template>
                                        <Text text="{CcMax}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label
                                        text="Min Range"
                                        tooltip="Min Range"
                                    />
                                    <table:template>
                                        <Text text="{MinRange}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label
                                        text="Max Range"
                                        tooltip="Max Range"
                                    />
                                    <table:template>
                                        <Text text="{MaxRange}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label
                                        text="RTO %"
                                        tooltip="RTO %"
                                    />
                                    <table:template>
                                        <Text text="{RtoPercent}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label
                                        text="RTO Value"
                                        tooltip="RTO Value"
                                    />
                                    <table:template>
                                        <Text text="{PriceValue}" />
                                    </table:template>
                                </table:Column>

                                <!-- <table:Column width="120px">
                            <Label text="Status" tooltip="Status"/>
                            <table:template>
                                <Text text="{Status}"/>
                            </table:template>
                        </table:Column> -->
                            </table:columns>
                        </table:Table>
                    </Panel>
                </VBox>
            </content>
        </Page>
    </App>
</mvc:View>
