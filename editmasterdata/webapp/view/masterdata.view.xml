<mvc:View
    controllerName="editmasterdata.controller.masterdata"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <Page>
        <!-- CENTER HEADER -->
        <!-- <customHeader>
                <Toolbar>
                        <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            press="onNavBack" />
                    <ToolbarSpacer/>
                    <Title text="Model Master" level="H2"/>
                    <ToolbarSpacer/>
                </Toolbar>             
            </customHeader> -->

        <customHeader>
            <Toolbar>
                <!-- Back Button -->
                <Button
                    icon="sap-icon://nav-back"
                    type="Transparent"
                    press="onNavBack"
                />

                <!-- Royal Enfield Logo -->
                <Image
                    src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
                    width="130px"
                    height="40px"
                    class="logoImage"
                />

                <!-- Spacer pushes title to center -->
                <ToolbarSpacer />

                <!-- Center Title -->
                <Title
                    text="Model Master"
                    class="textHeaderTitle"
                    level="H2"
                />

                <!-- Spacer keeps title centered -->
                <ToolbarSpacer />
            </Toolbar>
        </customHeader>

        <content>
            <VBox>
                <Toolbar>
                    <ToolbarSpacer />
                    <Button
                        text="Create Row"
                        icon="sap-icon://add"
                        enabled="{user>/isSubmitter}"
                        type="Emphasized"
                        press="onCreateMasterRow"
                    />

                    <Button
                        id="uploadExcelBtn"
                        text="Upload"
                        icon="sap-icon://upload-to-cloud"
                        type="Ghost"
                        tooltip="Upload Excel file"
                        enabled="{user>/isSubmitter}"
                        press="onUploadPress"
                    />

                    <Button
                        id="downloadExcelBtn"
                        text="Download"
                        icon="sap-icon://download"
                        type="Ghost"
                        tooltip="Download options"
                        press="onDownloadMenuPress"
                    />
                </Toolbar>
            </VBox>
            <!-- TABLE TOOLBAR -->

            <VBox class="sapUiSmallMarginTop">
                <Toolbar>
                    <HBox
                        alignItems="Center"
                        renderType="Bare"
                    >
                        <Label
                            text="Model Code"
                            class="sapUiTinyMarginEnd"
                        />

                        <!-- <MultiComboBox
                id="filterModelCode"
                width="220px"
                class="sapUiTinyMarginEnd"
                items="{filter>/Models}">
                <core:Item key="{filter>ModelCode}" text="{filter>Display}" />
            </MultiComboBox>  -->

                        <MultiComboBox
                            id="filterModelCode"
                            placeholder="All models"
                            width="220px"
                            class="sapUiTinyMarginEnd"
                            items="{
        path: 'filter>/Models',
        length: 9999
    }"
                        >
                            <core:Item
                                key="{filter>ModelCode}"
                                text="{filter>Display}"
                            />
                        </MultiComboBox>

                        <Label
                            text="Engine Type"
                            class="sapUiTinyMarginBegin sapUiTinyMarginEnd"
                        />

                        <MultiComboBox
                            id="filterEngineType"
                            width="180px"
                            class="sapUiTinyMarginEnd"
                            items="{
        path: 'filter>/EngineType',
        length: 9999
    }"
                        >
                            <core:Item
                                key="{filter>EngineType}"
                                text="{filter>EngineType}"
                            />
                        </MultiComboBox>

                        <Label
                            text="CC/Watt"
                            class="sapUiTinyMarginBegin sapUiTinyMarginEnd"
                        />

                        <MultiComboBox
                            id="filterCcType"
                            width="180px"
                            class="sapUiTinyMarginEnd"
                            items="{filter>/CcWatt}"
                        >
                            <core:Item
                                key="{filter>Ccwatt}"
                                text="{filter>Ccwatt}"
                            />
                        </MultiComboBox>

                        <Label
                            text="Family"
                            class="sapUiTinyMarginBegin sapUiTinyMarginEnd"
                        />

                        <MultiComboBox
                            id="filterFamilyType"
                            width="180px"
                            class="sapUiTinyMarginEnd"
                            items="{
        path: 'filter>/ModelFam',
        length: 9999
    }"
                        >
                            <core:Item
                                key="{filter>ModelFam}"
                                text="{filter>ModelFam}"
                            />
                        </MultiComboBox>
                    </HBox>

                    <!-- <ToolbarSpacer/> -->

                    <Button
                        text="Filter"
                        icon="sap-icon://filter"
                        class="sapUiTinyMarginEnd"
                        type="Emphasized"
                        press="onApplyFilter"
                    />

                    <Button
                        text="Clear"
                        icon="sap-icon://clear-filter"
                        type="Emphasized"
                        press="onClearFilter"
                    />

                    <Button
                        text="Rows"
                        icon="sap-icon://delete"
                        type="Reject"
                        tooltip="Remove selected rows"
                        press="onDeleteSelectedRows"
                    />
                </Toolbar>
            </VBox>

            <Bar />

            <!-- TABLE -->
            <table:Table
                id="modelTable"
                width="100%"
                rows="{ path: '/ModelMasterSet' }"
                visibleRowCount="13"
                enableColumnReordering="true"
                visibleRowCountMode="Fixed"
                selectionMode="None"
                enableBusyIndicator="true"
                sort="onSort"
            >
                <table:columns>
                    <!-- NON EDITABLE -->
                    <table:Column
                        width="150px"
                        sortProperty="ModelCode"
                    >
                        <Label text="Model Code" />

                        <table:template>
                            <HBox alignItems="Center">
                                <CheckBox
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                    selected="{_selectedForDelete}"
                                    select="onRowSelect"
                                    class="leftCheckBox"
                                />

                                <Text
                                    text="{ModelCode}"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <Input
                                    value="{ModelCode}"
                                    required="true"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                />
                            </HBox>
                        </table:template>
                    </table:Column>

                    <!-- <table:Column width="150px">
                            <Label text="Engine Type"/>
                            <table:template>
                                <Input value="{EngineType}"
                                 editable="{= ${@$ui5.context.isTransient} === true }"
            required="true"/>
            
                            </table:template>
                        </table:Column> -->

                    <!-- <table:Column width="150px">
    <Label text="Engine Type"/>

    <table:template>
        <ComboBox
            selectedKey="{EngineType}"
            editable="{= ${@$ui5.context.isTransient} === true }"
            required="true"
          
            width="100%">

            <core:Item key="EV" text="EV"/>
            <core:Item key="ICE" text="ICE"/>

        </ComboBox>
    </table:template>

</table:Column> -->

                    <table:Column
                        width="150px"
                        sortProperty="ModelCode"
                        sorted="true"
                        sortOrder="Ascending"
                    >
                        <Label
                            text="Engine Type"
                            tooltip="Engine Type"
                        />

                        <table:template>
                            <VBox>
                                <Text
                                    text="{EngineType}"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <Select
                                    selectedKey="{EngineType}"
                                    width="100%"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                >
                                    <core:Item
                                        key="EV"
                                        text="EV"
                                    />
                                    <core:Item
                                        key="ICE"
                                        text="ICE"
                                    />
                                </Select>
                            </VBox>
                        </table:template>
                    </table:Column>

                    <table:Column
                        width="120px"
                        sortProperty="ModelCode"
                        sorted="true"
                        sortOrder="Ascending"
                    >
                        <Label
                            text="CC/Watt"
                            tooltip="CC/Watt"
                        />
                        <table:template>
                            <VBox>
                                <Text
                                    text="{CcWatt}"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <Input
                                    type="Number"
                                    value="{CcWatt}"
                                    required="true"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                />
                            </VBox>
                        </table:template>
                    </table:Column>

                    <table:Column width="180px">
                        <Label
                            text="Effective Date"
                            tooltip="Effective Date"
                        />
                        <table:template>
                            <VBox>
                                <Text
                                    text="{
                path: 'FromDate',
                formatter: '.formatDateText'
            }"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <DatePicker
                                    value="{
                                   
                path: 'FromDate',
                type: 'sap.ui.model.type.Date'
            }"
           
                                    change="onDateChange"
                                    displayFormat="yyyy-MM-dd"
                                    valueFormat="yyyy-MM-dd"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                    minDate="{view>/minDate}"
                                />
                            </VBox>
                        </table:template>
                    </table:Column>

                    <table:Column width="200px">
                        <Label
                            text="Model Type"
                            tooltip="Model Type"
                        />
                        <table:template>
                            <VBox>
                                <Text
                                    text="{OrdType}"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <Select
                                    selectedKey="{OrdType}"
                                    width="100%"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                >
                                    <core:Item
                                        key=""
                                        text="Select Model Type"
                                        enabled="false"
                                    />

                                    <core:Item
                                        key="MTO"
                                        text="MTO"
                                    />
                                    <core:Item
                                        key="MTS"
                                        text="MTS"
                                    />
                                </Select>
                            </VBox>
                        </table:template>
                    </table:Column>

                    <table:Column width="200px">
                        <Label
                            text="Description"
                            tooltip="Description"
                        />
                        <table:template>
                            <VBox>
                                <Text
                                    text="{Description}"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <Input
                                    value="{Description}"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                />
                            </VBox>
                        </table:template>
                    </table:Column>

                    <table:Column width="160px">
                        <Label
                            text="Model Family"
                            tooltip="Model Family"
                        />
                        <table:template>
                            <VBox>
                                <Text
                                    text="{ModelFam}"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <Input
                                    value="{ModelFam}"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                />
                            </VBox>
                        </table:template>
                    </table:Column>

                    <table:Column width="120px">
                        <Label
                            text="GST%"
                            tooltip="GST%"
                        />
                        <table:template>
                            <VBox>
                                <Text
                                    text="{GstPerc}"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <Input
                                    type="Number"
                                    value="{path:'GstPerc', type:'sap.ca.ui.model.type.Number'}"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                />
                            </VBox>
                        </table:template>
                    </table:Column>

                    <table:Column width="160px">
                        <Label
                            text="Dealer Margin"
                            tooltip="Dealer Margin"
                        />
                        <table:template>
                            <VBox>
                                <Text
                                    text="{DealerMargin}"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <Input
                                    type="Number"
                                    value="{DealerMargin}"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                />
                            </VBox>
                        </table:template>
                    </table:Column>
                    <!-- 
                        <table:Column width="200px">
                            <Label text="Dealer Margin Calculation"/>
                            <table:template>
                                <Input value="{DealerMargCalc}"/>
                            </table:template>
                        </table:Column> -->

                    <table:Column width="200px">
                        <Label
                            text="Dealer Margin Calculation"
                            tooltip="Dealer Margin Calculation"
                        />

                        <table:template>
                            <VBox>
                                <Text
                                    text="{DealerMargCalc}"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <Select
                                    selectedKey="{DealerMargCalc}"
                                    width="100%"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                >
                                    <core:Item
                                        key="NSP"
                                        text="NSP"
                                    />
                                    <core:Item
                                        key="Dealer Cost"
                                        text="Dealer Cost"
                                    />
                                    <core:Item
                                        key="NDP"
                                        text="NDP"
                                    />
                                    <core:Item
                                        key="BASIS"
                                        text="BASIS"
                                    />
                                </Select>
                            </VBox>
                        </table:template>
                    </table:Column>
                    <table:Column width="200px">
                        <Label
                            text="Dealer Margin Cost Impact"
                            tooltip="Dealer Margin Cost Impact"
                        />
                        <table:template>
                            <VBox>
                                <Text
                                    text="{DealerMargCostImp}"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <Select
                                    selectedKey="{DealerMargCostImp}"
                                    width="100%"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                >
                                    <core:Item
                                        key="NSP"
                                        text="NSP"
                                    />
                                    <core:Item
                                        key="onBoard"
                                        text="OnRoad"
                                    />
                                </Select>
                            </VBox>
                        </table:template>
                    </table:Column>

                    <table:Column width="160px">
                        <Label
                            text="CSD Index Number"
                            tooltip="CSD Index Number"
                        />
                        <table:template>
                            <VBox>
                                <Text
                                    text="{CsdIndex}"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <Input
                                    type="Number"
                                    value="{CsdIndex}"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                />
                            </VBox>
                        </table:template>
                    </table:Column>

                    <table:Column width="160px">
                        <Label
                            text="CSD Discount Rate %"
                            tooltip="CDS Discount Rate %"
                        />
                        <table:template>
                            <VBox>
                                <Text
                                    text="{CsdDisPerc}"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <Input
                                    type="Number"
                                    value="{path:'CsdDisPerc', type:'sap.ca.ui.model.type.Number'}"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                />
                            </VBox>
                        </table:template>
                    </table:Column>

                    <table:Column width="120px">
                        <Label
                            text="GEM"
                            tooltip="GEM"
                        />
                        <table:template>
                            <VBox>
                                <Text
                                    text="{Gem}"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <Input
                                    type="Number"
                                    value="{path:'Gem', type:'sap.ca.ui.model.type.Number'}"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                />
                            </VBox>
                        </table:template>
                    </table:Column>

                    <!-- <table:Column width="120px">
                            <Label text="Model Status"/>
                            <table:template>
                                <Input value="{ModelStatus}"/>
                            </table:template>
                        </table:Column> -->

                    <table:Column width="120px">
                        <Label
                            text="Helmet Cost"
                            tooltip="Helmet Cost"
                        />
                        <table:template>
                            <VBox>
                                <Text
                                    text="{Helmet}"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <Input
                                    type="Number"
                                    value="{Helmet}"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                />
                            </VBox>
                        </table:template>
                    </table:Column>

                    <table:Column width="120px">
                        <Label
                            text="Helmet Margin"
                            tooltip="Helmet Margin"
                        />
                        <table:template>
                            <VBox>
                                <Text
                                    text="{HelmetMargin}"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <Input
                                    type="Number"
                                    value="{HelmetMargin}"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                />
                            </VBox>
                        </table:template>
                    </table:Column>

                    <table:Column width="200px">
                        <Label
                            text="Model Status"
                            tooltip="Model Status"
                        />

                        <table:template>
                            <VBox width="100%">
                                <!-- Existing rows -->
                                <Text
                                    text="{= ${ModelStatus} || 'Active' }"
                                    visible="{= ${@$ui5.context.isTransient} !== true }"
                                />

                                <!-- New row -->
                                <Select
                                    selectedKey="{ModelStatus}"
                                    width="100%"
                                    visible="{= ${@$ui5.context.isTransient} === true }"
                                >
                                    <core:Item
                                        key="Active"
                                        text="Active"
                                    />
                                    <core:Item
                                        key="inactive"
                                        text="In Active"
                                    />
                                    <core:Item
                                        key="instock"
                                        text="In Stock"
                                    />
                                </Select>
                            </VBox>
                        </table:template>
                    </table:Column>
                    <table:Column width="120px">
                        <Label
                            text="Status"
                            tooltip="Status"
                        />
                        <table:template>
                            <Text text="{Status}" />
                        </table:template>
                    </table:Column>

                    <table:Column width="120px">
                        <Label
                            text="Message"
                            tooltip="Status"
                        />
                        <table:template>
                            <Text text="{Message}" />
                        </table:template>
                    </table:Column>
                </table:columns>
            </table:Table>
        </content>

        <!-- FOOTER -->
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                    text="Submit"
                    enabled="{user>/isSubmitter}"
                    type="Emphasized"
                    press="onSubmit"
                />
            </OverflowToolbar>
        </footer>

        <dependents>
            <ActionSheet
                id="downloadActionSheet"
                title="Download Options"
                showCancelButton="true"
                cancelButtonText="Cancel"
            >
                <Button
                    text="Download All Data"
                    icon="sap-icon://download"
                    press="onExcelDownloadAll"
                />
                <Button
                    text="Select Fields &amp; Download"
                    icon="sap-icon://table-column"
                    press="onExcelDownload"
                />
            </ActionSheet>
        </dependents>

        <Dialog
            id="fieldSelectDialog"
            title="Select Fields to Download"
            contentWidth="250px"
        >
            <List
                id="fieldList"
                mode="MultiSelect"
                includeItemInSelection="true"
                items="{fields>/fields}"
            >
                <StandardListItem title="{fields>label}" />
            </List>

            <beginButton>
                <Button
                    text="Download"
                    type="Emphasized"
                    press="onDownloadSelectedFields"
                />
            </beginButton>

            <endButton>
                <Button
                    text="Cancel"
                    press="onCancelDownload"
                />
            </endButton>
        </Dialog>
    </Page>
</mvc:View>
