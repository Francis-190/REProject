<mvc:View
    controllerName="editmasterdata.controller.partcode"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <App>
        <Page
            backgroundDesign="Solid"
            style="background: #f5f7fb;"
        >
            <customHeader>
                <Toolbar>
                    <!-- Back Button -->
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        press="onNavBack"
                    />

                    <!-- Royal Enfield Logo -->
                    <Image
                        src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
                        width="130px"
                        height="40px"
                        class="logoImage"
                    />

                    <!-- Spacer pushes title to center -->
                    <ToolbarSpacer />

                    <!-- Center Title -->
                    <Title
                        text="Part Code Master"
                        class="textHeaderTitle"
                        level="H2"
                    />

                    <!-- Spacer keeps title centered -->
                    <ToolbarSpacer />
                </Toolbar>
            </customHeader>

            <content>
                <VBox style="padding: 24px 28px;">
                   
                            <Toolbar>
                                <ToolbarSpacer />
                                <Button
                                    text="Create Row"
                                    icon="sap-icon://add"
                                    press="onCreateMasterRow"
                                    enabled="{user>/isSubmitter}"
                                    type="Emphasized"
                                    style="border-radius: 8px; font-weight: 600;"
                                />

                                <Button
                                    text="Upload"
                                    icon="sap-icon://upload-to-cloud"
                                    type="Ghost"
                                    press="onUploadPress"
                                    enabled="{user>/isSubmitter}"
                                />

                                <Button
                                    text="Download"
                                    icon="sap-icon://download"
                                    type="Ghost"
                                    press="onDownloadMenuPress"
                                />
                            </Toolbar>
                       

                        <VBox class="sapUiSmallMarginTop">
                            <Toolbar>
                                <HBox
                                    alignItems="Center"
                                    renderType="Bare"
                                >
                                    <Label
                                        text="Meterial Group"
                                        class="sapUiTinyMarginEnd"
                                    />

                                    <MultiComboBox
                                        id="filterModelCode"
                                        width="220px"
                                        class="sapUiTinyMarginEnd"
                                        items="{
        path: 'filter>/Family',
        length: 9999
    }"
                                    >
                                        <core:Item
                                            key="{filter>Family}"
                                            text="{filter>Family}"
                                        />
                                    </MultiComboBox>

                                    <Label
                                        text="Part Code"
                                        class="sapUiTinyMarginBegin sapUiTinyMarginEnd"
                                    />

                                    <MultiComboBox
                                        id="filterEngineType"
                                        width="180px"
                                        class="sapUiTinyMarginEnd"
                                        items="{
        path: 'filter>/PartCode',
        length: 9999
    }"
                                    >
                                        <core:Item
                                            key="{filter>PartCode}"
                                            text="{filter>PartCode}"
                                        />
                                    </MultiComboBox>
                                </HBox>

                                <!-- <ToolbarSpacer/> -->

                                <Button
                                    text="Filter"
                                    icon="sap-icon://filter"
                                    type="Emphasized"
                                    class="sapUiTinyMarginEnd"
                                    press="onApplyFilter"
                                />

                                <Button
                                    text="Clear"
                                    icon="sap-icon://clear-filter"
                                    type="Emphasized"
                                    press="onClearFilter"
                                />
                                <Button
                                    text="Rows"
                                    icon="sap-icon://delete"
                                    type="Reject"
                                    tooltip="Remove selected rows"
                                    press="onDeleteSelectedRows"
                                />
                            </Toolbar>
                        </VBox>

                        <Bar />

                        <table:Table
                            id="partMasterTable"
                            rows="{/PartsSet}"
                            visibleRowCount="13"
                            enableBusyIndicator="true"
                            enableColumnReordering="true"
                            selectionMode="None"
                            width="100%"
                            sort="onSort"
                        >
                            <table:columns>
                                <table:Column
                                    width="160px"
                                    sortProperty="Family"
                                    sorted="true"
                                    sortOrder="Ascending"
                                >
                                    <Label
                                        text="Material Group"
                                        tooltip="Material Group"
                                    />

                                    <table:template>
                                        <HBox
                                            width="100%"
                                            alignItems="Center"
                                        >
                                            <CheckBox
                                                selected="{_selectedForDelete}"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                                select="onNewRowSelect"
                                            />

                                            <Text
                                                text="{Family}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <Input
                                                value="{Family}"
                                                required="true"
                                                width="95px"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                                class="sapUiTinyMarginBegin"
                                            />
                                        </HBox>
                                    </table:template>
                                </table:Column>
                                <table:Column
                                    width="150px"
                                    sortProperty="PartCode"
                                    sorted="true"
                                    sortOrder="Ascending"
                                >
                                    <Label
                                        text="Part Code"
                                        tooltip="Part Code"
                                    />

                                    <table:template>
                                        <VBox>
                                            <Text
                                                text="{PartCode}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <Input
                                                value="{PartCode}"
                                                required="true"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                            />
                                        </VBox>
                                    </table:template>
                                </table:Column>

                                <table:Column width="150px">
                                    <Label
                                        text="Effective Date"
                                        tooltip="Effective Date"
                                    />

                                    <table:template>
                                        <VBox>
                                            <!-- Existing rows -->
                                            <Text
                                                text="{path: 'FromDate', formatter: '.formatDate'}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <!-- Create Row -->
                                            <DatePicker
                                                value="{path: 'FromDate', formatter: '.formatDate'}"
                                                change="onDateChange"
                                                displayFormat="dd MMM yyyy"
                                                valueFormat="yyyy-MM-dd"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                                minDate="{view>/minDate}"
                                            />
                                        </VBox>
                                    </table:template>
                                </table:Column>
                                <table:Column width="250px">
                                    <Label
                                        text="Description"
                                        tooltip="Description"
                                    />

                                    <table:template>
                                        <VBox>
                                            <Text
                                                text="{PartDescr}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <Input
                                                value="{PartDescr}"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                            />
                                        </VBox>
                                    </table:template>
                                </table:Column>

                                <table:Column width="160px">
                                    <Label
                                        text="OE/GMA/GMA OE"
                                        tooltip="OE/GMA/GMA OE"
                                    />
                                    <table:template>
                                        <VBox>
                                            <Text
                                                text="{OeGma}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />
                                            <Select
                                                selectedKey="{OeGma}"
                                                width="100%"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                            >
                                                <core:Item
                                                    key="OE"
                                                    text="OE"
                                                />
                                                <core:Item
                                                    key="GMA"
                                                    text="GMA"
                                                />
                                                <core:Item
                                                    key="GMA OE"
                                                    text="GMA OE"
                                                />
                                            </Select>
                                        </VBox>
                                    </table:template>
                                </table:Column>
                                <table:Column width="120px">
                                    <Label
                                        text="MRP"
                                        tooltip="MRP"
                                    />

                                    <table:template>
                                        <VBox>
                                            <Text
                                                text="{Mrp}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <Input
                                                type="Number"
                                                value="{Mrp}"
                                                change=".onPriceChange"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                            />
                                        </VBox>
                                    </table:template>
                                </table:Column>
                                <table:Column width="120px">
                                    <Label
                                        text="MIY Cost"
                                        tooltip="MIY Cost"
                                    />

                                    <table:template>
                                        <VBox>
                                            <Text
                                                text="{MiyCost}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <Input
                                                type="Number"
                                                value="{MiyCost}"
                                                change=".onPriceChange"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                            />
                                        </VBox>
                                    </table:template>
                                </table:Column>
                                <table:Column width="120px">
                                    <Label
                                        text="MIY Markup"
                                        tooltip="MIY Markup"
                                    />

                                    <table:template>
                                        <VBox>
                                            <Text
                                                text="{MiyMarkup}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <Input
                                                type="Number"
                                                value="{MiyMarkup}"
                                                change=".onPriceChange"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                            />
                                        </VBox>
                                    </table:template>
                                </table:Column>

                                <table:Column width="120px">
                                    <Label
                                        text="MIY Cost %"
                                        tooltip="MIY Cost"
                                    />

                                    <table:template>
                                        <VBox>
                                            <Text
                                                text="{MiyCostPerc}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <Input
                                               
                                                value="{MiyCostPerc}"
                                                editable="false"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                            />
                                        </VBox>
                                    </table:template>
                                </table:Column>
                                <table:Column width="140px">
                                    <Label
                                        text="MiY Markup %"
                                        tooltip="MIY Markup"
                                    />

                                    <table:template>
                                        <VBox>
                                            <Text
                                                text="{MiyMarkupPerc}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <Input
                                             
                                                value="{MiyMarkupPerc}"
                                                editable="false"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                            />
                                        </VBox>
                                    </table:template>
                                </table:Column>

                                <table:Column width="180px">
                                    <Label
                                        text="Ex Showroom / On Road"
                                        tooltip="Ex Showroom / On Road"
                                    />

                                    <table:template>
                                        <VBox>
                                            <Text
                                                text="{ExShowOnRoad}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <Select
                                                selectedKey="{ExShowOnRoad}"
                                                width="100%"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                            >
                                                <core:Item
                                                    key="EX SHOWROOM"
                                                    text="EX SHOWROOM"
                                                />

                                                <core:Item
                                                    key="ON ROAD"
                                                    text="ON ROAD"
                                                />
                                            </Select>
                                        </VBox>
                                    </table:template>
                                </table:Column>

                                <table:Column width="120px">
                                    <Label
                                        text="Status"
                                        tooltip="Status"
                                    />

                                    <table:template>
                                        <Text text="{Status}" />
                                    </table:template>
                                </table:Column>
                            </table:columns>
                        </table:Table>
                 
                </VBox>
            </content>

            <footer>
                <OverflowToolbar>
                    <ToolbarSpacer />
                    <Button
                        text="Submit"
                        type="Emphasized"
                        enabled="{user>/isSubmitter}"
                        press="onSubmit"
                        style="border-radius: 8px; font-weight: 700; min-width: 120px;"
                    />
                </OverflowToolbar>
            </footer>
            <dependents>
                <ActionSheet
                    id="downloadActionSheet"
                    title="Download Options"
                    showCancelButton="true"
                    cancelButtonText="Cancel"
                >
                    <Button
                        text="Download All Data"
                        press="onExcelDownloadAll"
                    />
                    <Button
                        text="Select Fields &amp; Download"
                        press="onExcelDownload"
                    />
                </ActionSheet>

                <Dialog
                    id="fieldSelectDialog"
                    title="Select Fields to Download"
                    contentWidth="250px"
                >
                    <List
                        id="fieldList"
                        mode="MultiSelect"
                        includeItemInSelection="true"
                        items="{fields>/fields}"
                    >
                        <StandardListItem title="{fields>label}" />
                    </List>

                    <beginButton>
                        <Button
                            text="Download"
                            press="onDownloadSelectedFields"
                        />
                    </beginButton>

                    <endButton>
                        <Button
                            text="Cancel"
                            press="onCancelDownload"
                        />
                    </endButton>
                </Dialog>
            </dependents>
        </Page>
    </App>
</mvc:View>
