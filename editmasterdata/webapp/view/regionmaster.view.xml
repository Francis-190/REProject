<mvc:View
    controllerName="editmasterdata.controller.regionmaster"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <Page>
        <customHeader>
            <Toolbar>
                <!-- Back Button -->
                <Button
                    icon="sap-icon://nav-back"
                    type="Transparent"
                    press="onNavBack"
                />

                <!-- Royal Enfield Logo -->
                <Image
                    src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
                    width="130px"
                    height="40px"
                    class="logoImage"
                />

                <!-- Spacer pushes title to center -->
                <ToolbarSpacer />

                <!-- Center Title -->
                <Title
                    text="Region Master"
                    class="textHeaderTitle"
                    level="H2"
                />

                <!-- Spacer keeps title centered -->
                <ToolbarSpacer />
            </Toolbar>
        </customHeader>
        <!-- TABLE -->
        <content>
            <VBox
               
            >
              
                    
                        <Toolbar>
                            <ToolbarSpacer />
                            <Button
                                text="Create Row"
                                type="Emphasized"
                                 enabled="{user>/isSubmitter}"
                                icon="sap-icon://add"
                                press="onCreateMasterRow"
                            />

                            <Button
                                id="excelMenuBtn"
                                text="Upload"
                                icon="sap-icon://upload-to-cloud"
                                type="Ghost"
                                press="onExcelPress"
                                enabled="{user>/isSubmitter}"
                            />

                            <Button
                                id="downloadExcelBtn"
                                text="Download"
                                icon="sap-icon://download"
                                type="Ghost"
                                tooltip="Download options"
                                press="onDownloadMenuPress"
                            />
                        </Toolbar>
                 

                    <VBox class="sapUiSmallMarginTop">
                        <Toolbar>
                            <HBox
                                alignItems="Center"
                                renderType="Bare"
                            >
                                <Label
                                    text="Region Code"
                                    class="sapUiTinyMarginEnd"
                                />

                                <MultiComboBox
                                    id="filterModelCode"
                                    width="220px"
                                    class="sapUiTinyMarginEnd"
                                    items="{filter>/Models}"
                                >
                                    <core:Item
                                        key="{filter>Region}"
                                        text="{filter>Display}"
                                    />
                                </MultiComboBox>
                            </HBox>

                            <!-- <ToolbarSpacer/> -->

                            <Button
                                text="Filter"
                                icon="sap-icon://filter"
                                class="sapUiTinyMarginEnd"
                                type="Emphasized"
                                press="onApplyFilter"
                            />

                            <Button
                                text="Clear"
                                icon="sap-icon://clear-filter"
                                type="Emphasized"
                                press="onClearFilter"
                            />

                            <Button
                                text="Rows"
                                icon="sap-icon://delete"
                                type="Reject"
                                tooltip="Remove selected rows"
                                press="onDeleteSelectedRows"
                            />
                        </Toolbar>
                    </VBox>

                    <Bar />

                    <table:Table
                        id="regionTables"
                        rows="{/RegionMasterSet}"
                        visibleRowCount="13"
                        enableColumnReordering="true"
                        selectionMode="None"
                        width="100%"
                        enableBusyIndicator="true"
                        sort="onSort"
                    >
                        <table:columns>
                            <table:Column
                                sortProperty="Region"
                                sorted="true"
                                sortOrder="Ascending"
                            >
                                <Label
                                    text="Region"
                                    tooltip="Region"
                                />
                                <table:template>
                                    <HBox
                                        width="100%"
                                        alignItems="Center"
                                    >
                                        <!-- Checkbox only for newly created rows -->
                                        <CheckBox
                                            selected="{_selectedForDelete}"
                                            visible="{= ${@$ui5.context.isTransient} === true }"
                                            select="onNewRowSelect"
                                        />

                                        <!-- Existing row -->
                                        <Text
                                            text="{Region}"
                                            visible="{= ${@$ui5.context.isTransient} !== true }"
                                        />

                                        <!-- New row -->
                                        <Input
                                            value="{Region}"
                                            required="true"
                                            width="230px"
                                            visible="{= ${@$ui5.context.isTransient} === true }"
                                            class="sapUiTinyMarginBegin"
                                        />
                                    </HBox>
                                </table:template>
                            </table:Column>

                            <table:Column width="150px">
                                <Label
                                    text="Engine Type"
                                    tooltip="Engine Type"
                                />

                                <table:template>
                                    <VBox>
                                        <Text
                                            text="{EngineType}"
                                            visible="{= ${@$ui5.context.isTransient} !== true }"
                                        />

                                        <Select
                                            selectedKey="{EngineType}"
                                            width="100%"
                                            visible="{= ${@$ui5.context.isTransient} === true }"
                                        >
                                            <core:Item
                                                key="EV"
                                                text="EV"
                                            />
                                            <core:Item
                                                key="ICE"
                                                text="ICE"
                                            />
                                        </Select>
                                    </VBox>
                                </table:template>
                            </table:Column>

                            <table:Column>
                                <Label
                                    text="Description"
                                    tooltip="Description"
                                />
                                <table:template>
                                    <VBox>
                                        <Text
                                            text="{Ort01}"
                                            visible="{= ${@$ui5.context.isTransient} !== true }"
                                        />

                                        <Input
                                            value="{Ort01}"
                                            maxLength="40"
                                            valueLiveUpdate="true"
                                           
                                            visible="{= ${@$ui5.context.isTransient} === true }"
                                        />
                                    </VBox>
                                </table:template>
                            </table:Column>

                            <!-- <table:Column>
                    <Label text="Efective Date" tooltip="Efective Date"/>
                    <table:template>
                        <Input value="{FromDate}"  maxLength="40"
            valueLiveUpdate="true"/>
                    </table:template>
                </table:Column> -->

                            <table:Column>
                                <Label
                                    text="Effective Date"
                                    tooltip="Effective Date"
                                />
                                <table:template>
                                    <VBox>
                                        <!-- Existing row -->
                                        <Text
                                            text="{path: 'FromDate', formatter: '.formatDate'}"
                                            visible="{= ${@$ui5.context.isTransient} !== true }"

                                        />

                                        <!-- Newly created row -->
                                        <DatePicker
                                            value="{
                path: 'FromDate',
                formatter: '.formatDate'
            }"
                                            change="onDateChange"
                                            displayFormat="dd MMM yyyy"
                                            valueFormat="yyyy-MM-dd"
                                             minDate="{view>/minDate}"
                                            visible="{= ${@$ui5.context.isTransient} === true }"
                                        />
                                    </VBox>
                                </table:template>
                            </table:Column>

                            <table:Column>
                                <Label
                                    text="Language"
                                    tooltip="Language"
                                />
                                <table:template>
                                    <VBox>
                                        <Text
                                            text="{Spras}"
                                            visible="{= ${@$ui5.context.isTransient} !== true }"
                                        />

                                        <Input
                                            value="{Spras}"
                                            visible="{= ${@$ui5.context.isTransient} === true }"
                                        />
                                    </VBox>
                                </table:template>
                            </table:Column>

                            <table:Column>
                                <Label
                                    text="Basic For RTO"
                                    tooltip="Basis For RTO"
                                />
                                <table:template>
                                    <VBox>
                                        <Text
                                            text="{BasisRto}"
                                            visible="{= ${@$ui5.context.isTransient} !== true }"
                                        />

                                        <Select
                                            selectedKey="{BasisRto}"
                                            width="100%"
                                            visible="{= ${@$ui5.context.isTransient} === true }"
                                        >
                                            <core:Item
                                                key="EXSHOWROOM"
                                                text="EXSHOWROOM"
                                            />

                                            <core:Item
                                                key="BASIC"
                                                text="BASIC"
                                            />
                                        </Select>
                                    </VBox>
                                </table:template>
                            </table:Column>

                            <table:Column width="120px">
                                <Label
                                    text="Status"
                                    tooltip="Status"
                                />
                                <table:template>
                                    <Text text="{Status}" />
                                </table:template>
                            </table:Column>
                        </table:columns>
                    </table:Table>
              
            </VBox>
        </content>

        <!-- FOOTER -->
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                    text="Submit"
                    type="Emphasized"
                      enabled="{user>/isSubmitter}"
                    press="onSubmit"
                />
            </OverflowToolbar>
        </footer>

        <Popover
            id="excelPopover"
            placement="Bottom"
            showHeader="false"
            contentWidth="130px"
        >
            <VBox
                class="sapUiSmallMargin"
                width="100%"
            >
                <Button
                    text="Upload"
                    icon="sap-icon://upload-to-cloud"
                    press="onExcelPress"
                    type="Ghost"
                />
                <Button
                    text="Download"
                    icon="sap-icon://download"
                    type="Ghost"
                    press="onExcelDownload"
                />
            </VBox>
        </Popover>

        <Dialog
            id="fieldSelectDialog"
            title="Select Fields to Download"
            contentWidth="250px"
        >
            <List
                id="fieldList"
                mode="MultiSelect"
                includeItemInSelection="true"
            >
                <StandardListItem title="Region" />
                <StandardListItem title="Description" />
                <StandardListItem title="Language" />
                <StandardListItem title="Basis for RTO" />
                <StandardListItem title="Engine Type" />
                <StandardListItem title="Effective Date" />
            </List>

            <beginButton>
                <Button
                    text="Download"
                    type="Emphasized"
                    press="onDownloadSelectedFields"
                />
            </beginButton>

            <endButton>
                <Button
                    text="Cancel"
                    press="onCancelDownload"
                />
            </endButton>
        </Dialog>

        <HBox visible="true">
            <core:HTML
                id="vpFileInputHTML"
                content="&lt;input type='file' id='vpExcelFileInput' accept='.xlsx,.xls,.csv' style='display:none' /&gt;"
            />
        </HBox>

        <dependents>
            <ActionSheet
                id="downloadActionSheet"
                title="Download Options"
                showCancelButton="true"
                cancelButtonText="Cancel"
            >
                <Button
                    text="Download All Data"
                    icon="sap-icon://download"
                    press="onExcelDownloadAll"
                />
                <Button
                    text="Select Fields &amp; Download"
                    icon="sap-icon://table-column"
                    press="onExcelDownload"
                />
            </ActionSheet>
        </dependents>
    </Page>
</mvc:View>
