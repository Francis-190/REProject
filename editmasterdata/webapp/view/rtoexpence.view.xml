<mvc:View
    controllerName="editmasterdata.controller.rtoexpence"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <App>
        <Page>
            <!-- <customHeader>
                <Toolbar>
                        <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            press="onNavBack" />
                    <ToolbarSpacer />
                    <Title text="RTO Expence" level="H2" />
                    <ToolbarSpacer />
                </Toolbar>
            </customHeader> -->

            <customHeader>
                <Toolbar>
                    <!-- Back Button -->
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        press="onNavBack"
                    />

                    <!-- Royal Enfield Logo -->
                    <Image
                        src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
                        width="130px"
                        height="40px"
                        class="logoImage"
                    />

                    <!-- Spacer pushes title to center -->
                    <ToolbarSpacer />

                    <!-- Center Title -->
                    <Title
                        text="RTO Expence"
                        class="textHeaderTitle"
                        level="H2"
                    />

                    <!-- Spacer keeps title centered -->
                    <ToolbarSpacer />
                </Toolbar>
            </customHeader>
            <!-- TABLE -->
            <content>
                <VBox
                   
                >
                   
                            <Toolbar>
                                <ToolbarSpacer />
                                <Button
                                    text="Create Row"
                                    type="Emphasized"
                                    enabled="{user>/isSubmitter}"
                                    icon="sap-icon://add"
                                    press="onCreateMasterRow"
                                />

                                <Button
                                    id="uploadExcelBtn"
                                    text="Upload"
                                    icon="sap-icon://upload-to-cloud"
                                    type="Ghost"
                                    tooltip="Upload Excel file"
                                    press="onUploadPress"
                                    enabled="{user>/isSubmitter}"
                                />

                                <Button
                                    text="Download"
                                    icon="sap-icon://download"
                                    type="Ghost"
                                    press="onDownloadMenuPress"
                                />
                            </Toolbar>
                       

                        <VBox class="sapUiSmallMarginTop">
                            <Toolbar>
                                <HBox
                                    alignItems="Center"
                                    renderType="Bare"
                                >
                                    <Label
                                        text="Region Code"
                                        class="sapUiTinyMarginEnd"
                                    />

                                    <MultiComboBox
                                        id="filterModelCode"
                                        width="220px"
                                        class="sapUiTinyMarginEnd"
                                        items="{filter>/RegionCode}"
                                    >
                                        <core:Item
                                            key="{filter>RegionCode}"
                                            text="{filter>Display}"
                                        />
                                    </MultiComboBox>
                                </HBox>

                                <!-- <ToolbarSpacer/> -->

                                <Button
                                    text="Filter"
                                    icon="sap-icon://filter"
                                    type="Emphasized"
                                    class="sapUiTinyMarginEnd"
                                    press="onApplyFilter"
                                />

                                <Button
                                    text="Clear"
                                    icon="sap-icon://clear-filter"
                                    type="Emphasized"
                                    press="onClearFilter"
                                />
                                <Button
                                    text="Rows"
                                    icon="sap-icon://delete"
                                    type="Reject"
                                    tooltip="Remove selected rows"
                                    press="onDeleteSelectedRows"
                                />
                            </Toolbar>
                        </VBox>

                        <Bar />
                        <table:Table
                            id="RtoExpenceTable"
                            rows="{/RTOExpenseSet}"
                            visibleRowCount="13"
                            selectionMode="Single"
                            width="100%"
                            enableBusyIndicator="true"
                            enableColumnReordering="true"
                            sort="onSort"
                        >
                            <table:columns>
                                <!-- Region -->
                                <table:Column
                                    sortProperty="RegionCode"
                                    sorted="true"
                                    sortOrder="Ascending"
                                >
                                    <Label
                                        text="Region"
                                        tooltip="Region"
                                    />

                                    <table:template>
                                        <HBox
                                            width="100%"
                                            alignItems="Center"
                                        >
                                            <!-- Checkbox only for newly created rows -->
                                            <CheckBox
                                                selected="{_selectedForDelete}"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                                select="onNewRowSelect"
                                            />

                                            <!-- Existing row -->
                                            <Text
                                                text="{RegionCode}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <!-- Newly created row -->
                                            <Input
                                                type="Number"
                                                value="{RegionCode}"
                                                required="true"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                                class="sapUiTinyMarginBegin"
                                            />
                                        </HBox>
                                    </table:template>
                                </table:Column>

                                <!-- Engine Type -->
                                <table:Column width="150px">
                                    <Label
                                        text="Engine Type"
                                        tooltip="Engine Type"
                                    />

                                    <table:template>
                                        <VBox>
                                            <Text
                                                text="{EngineType}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <Select
                                                selectedKey="{EngineType}"
                                                width="100%"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                            >
                                                <core:Item
                                                    key="EV"
                                                    text="EV"
                                                />

                                                <core:Item
                                                    key="ICE"
                                                    text="ICE"
                                                />
                                            </Select>
                                        </VBox>
                                    </table:template>
                                </table:Column>

                                <!-- Effective Date -->
                                <table:Column width="150px">
                                    <Label
                                        text="Effective Date"
                                        tooltip="Effective Date"
                                    />

                                    <table:template>
                                        <VBox>
                                            <!-- Existing rows -->
                                            <Text
                                                text="{path: 'FromDate', formatter: '.formatDate'}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <!-- Newly created row -->
                                            <DatePicker
                                                value="{path: 'FromDate', formatter: '.formatDate'}"
                                                change="onDateChange"
                                                displayFormat="dd MMM yyyy"
                                                valueFormat="yyyy-MM-dd"
                                                 minDate="{view>/minDate}"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                            />
                                        </VBox>
                                    </table:template>
                                </table:Column>

                                <!-- Slab -->
                                <table:Column
                                    sortProperty="Slab"
                                    sorted="true"
                                    sortOrder="Ascending"
                                >
                                    <Label
                                        text="Slab"
                                        tooltip="Slab"
                                    />

                                    <table:template>
                                        <VBox>
                                            <Text
                                                text="{Slab}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <Input
                                                type="Number"
                                                value="{Slab}"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                            />
                                        </VBox>
                                    </table:template>
                                </table:Column>

                                <!-- Min Range -->
                                <table:Column>
                                    <Label
                                        text="Min Range"
                                        tooltip="Min Range"
                                    />

                                    <table:template>
                                        <VBox>
                                            <Text
                                                text="{MinRange}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <Input
                                                type="Number"
                                                value="{MinRange}"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                            />
                                        </VBox>
                                    </table:template>
                                </table:Column>

                                <!-- Max Range -->
                                <table:Column>
                                    <Label
                                        text="Max Range"
                                        tooltip="Max Range"
                                    />

                                    <table:template>
                                        <VBox>
                                            <Text
                                                text="{MaxRange}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <Input
                                                type="Number"
                                                value="{MaxRange}"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                            />
                                        </VBox>
                                    </table:template>
                                </table:Column>

                                <!-- Expense -->
                                <table:Column>
                                    <Label
                                        text="Expense"
                                        tooltip="Expense"
                                    />

                                    <table:template>
                                        <VBox>
                                            <Text
                                                text="{Expense}"
                                                visible="{= ${@$ui5.context.isTransient} !== true }"
                                            />

                                            <Input
                                                type="Number"
                                                value="{Expense}"
                                                visible="{= ${@$ui5.context.isTransient} === true }"
                                            />
                                        </VBox>
                                    </table:template>
                                </table:Column>

                                <!-- Status -->
                                <table:Column width="120px">
                                    <Label
                                        text="Status"
                                        tooltip="Status"
                                    />

                                    <table:template>
                                        <Text text="{Status}" />
                                    </table:template>
                                </table:Column>
                            </table:columns>
                        </table:Table>
                 
                </VBox>
            </content>
            <!-- FOOTER -->
            <footer>
                <OverflowToolbar>
                    <ToolbarSpacer />
                    <Button
                        text="Submit"
                          enabled="{user>/isSubmitter}"
                        type="Emphasized"
                        press="onSubmit"
                    />
                </OverflowToolbar>
            </footer>

            <dependents>
                <ActionSheet
                    id="downloadActionSheet"
                    title="Download Options"
                    showCancelButton="true"
                    cancelButtonText="Cancel"
                >
                    <Button
                        text="Download All Data"
                        icon="sap-icon://download"
                        press="onDownloadAll"
                    />
                    <Button
                        text="Select Fields &amp; Download"
                        icon="sap-icon://table-column"
                        press="onExcelDownload"
                    />
                </ActionSheet>
            </dependents>

            <Dialog
                id="fieldSelectDialog"
                title="Select Fields to Download"
                contentWidth="250px"
            >
                <List
                    id="fieldList"
                    mode="MultiSelect"
                    includeItemInSelection="true"
                    items="{fields>/fields}"
                >
                    <StandardListItem title="{fields>label}" />
                </List>

                <beginButton>
                    <Button
                        text="Download"
                        type="Emphasized"
                        press="onDownloadSelectedFields"
                    />
                </beginButton>

                <endButton>
                    <Button
                        text="Cancel"
                        press="onCancelDownload"
                    />
                </endButton>
            </Dialog>
        </Page>
    </App>
</mvc:View>
