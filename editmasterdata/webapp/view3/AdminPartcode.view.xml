<mvc:View
    controllerName="editmasterdata.controller.AdminPartcode"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true">
<App>
        <Page>

            <!-- CENTER HEADER -->
            <customHeader>
                <Toolbar>
                        <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            press="onNavBack" />
                    <ToolbarSpacer/>
                    <Title text=" Admin Part Code Master" level="H2"/>
                    <ToolbarSpacer/>
                </Toolbar>
            </customHeader>

            <content>

                <!-- TABLE TOOLBAR -->
                <!-- TABLE -->
<table:Table
    id="AdminpartMasterTable"
    rows="{/PartsSet}"
    visibleRowCount="4"
    enableBusyIndicator="true"
    selectionMode="None"
    width="100%">

   <table:columns>

    <!-- Family -->
    <table:Column width="120px">
        <Label text="Family"/>
        <table:template>
            <Text text="{Family}"/>
        </table:template>
    </table:Column>

    <!-- Part Code -->
    <table:Column width="150px">
        <Label text="Part code"/>
        <table:template>
            <Text text="{PartCode}"/>
        </table:template>
    </table:Column>

    <!-- Description -->
    <table:Column width="250px">
        <Label text="Description"/>
        <table:template>
            <Text text="{PartDescr}"/>
        </table:template>
    </table:Column>

    <!-- OE/GMA/GMA OE -->
    <table:Column width="160px">
        <Label text="OE/GMA/GMA OE"/>
        <table:template>
            <Text text="{OeGma}"/>
        </table:template>
    </table:Column>

    <!-- MRP -->
    <table:Column width="120px">
        <Label text="MRP"/>
        <table:template>
            <Text text="{Mrp}"/>
        </table:template>
    </table:Column>

    <!-- MiY Cost -->
    <table:Column width="120px">
        <Label text="MiY Cost"/>
        <table:template>
            <Text text="{MiyCost}"/>
        </table:template>
    </table:Column>

    <!-- MiY Markup -->
    <table:Column width="120px">
        <Label text="MiY Markup"/>
        <table:template>
            <Text text="{MiyMarkup}"/>
        </table:template>
    </table:Column>

    <!-- Ex showroom / On Road -->
    <table:Column width="180px">
        <Label text="Ex showroom / On Road"/>
        <table:template>
            <Text text="{ExShowOnRoad}"/>
        </table:template>
    </table:Column>

    <!-- MiY Cost % -->
    <table:Column width="120px">
        <Label text="MiY Cost %"/>
        <table:template>
            <Text text="{MiyCostPerc}"/>
        </table:template>
    </table:Column>

    <!-- MiY Markup % -->
    <table:Column width="140px">
        <Label text="MiY Markup %"/>
        <table:template>
            <Text text="{MiyMarkupPerc}"/>
        </table:template>
    </table:Column>

    <!-- In Active -->

</table:columns>
</table:Table>



            </content>

            <!-- FOOTER -->
        <footer>
    <OverflowToolbar>
        <ToolbarSpacer/>
        <Button
            text="Approve"
            type="Accept"
            icon="sap-icon://accept"
            press="onApprove"/>
        <Button
            text="Reject"
            type="Reject"
            icon="sap-icon://decline"
            press="onReject"/>
    </OverflowToolbar>
</footer>

        </Page>
    </App>
</mvc:View>
