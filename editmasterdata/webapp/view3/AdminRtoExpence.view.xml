<mvc:View controllerName="editmasterdata.controller.AdminRtoExpence"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <App>
        <Page enableScrolling="false">
            <customHeader>
                <Toolbar>
                        <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            press="onNavBack" />
                    <ToolbarSpacer />
                    <Title text="Admin RTO Expence" level="H2" />
                    <ToolbarSpacer />
                </Toolbar>
            </customHeader>
            <!-- TABLE -->
            <content>
                <VBox width="100%" alignItems="Center">
                    <Panel width="95%" class="sapUiResponsiveMargin">
   
                        <table:Table
                            id="RtoExpenceTableAdmin"
                            rows="{/RTOExpenseSet}"
                            visibleRowCount="10"
                            selectionMode="None"
                            width="100%"
                            enableBusyIndicator="true">
                            <table:columns>
                                <table:Column>
                                    <Label text="Region" />
                                    <table:template>
                                        <Text text="{RegionCode}" />
                                    </table:template>
                                </table:Column>
                                <table:Column>
                                    <Label text="Min Range" />
                                    <table:template>
                                        <Text text="{MinRange}" />
                                    </table:template>
                                </table:Column>
                                <table:Column>
                                    <Label text="Max Range" />
                                    <table:template>
                                        <Text text="{MaxRange}" />
                                    </table:template>
                                </table:Column>
                                <table:Column>
                                    <Label text="Expence" />
                                    <table:template>
                                        <Text text="{Expense}" />
                                    </table:template>
                                </table:Column>
                            </table:columns>
                        </table:Table>
                    </Panel>
                </VBox>
            </content>
            <!-- FOOTER -->
          <footer>
    <OverflowToolbar>
        <ToolbarSpacer/>
        <Button
            text="Approve"
            type="Accept"
            icon="sap-icon://accept"
            press="onApprove"/>
        <Button
            text="Reject"
            type="Reject"
            icon="sap-icon://decline"
            press="onReject"/>
    </OverflowToolbar>
</footer>
        </Page>
    </App>
</mvc:View>