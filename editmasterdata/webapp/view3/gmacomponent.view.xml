            <content >

<VBox >

     <Toolbar>

     <Label text="Model" class="sapUiTinyMarginEnd"/>

            <MultiComboBox
                id="filterModelCode"
                width="220px"
                class="sapUiTinyMarginEnd"
                items="{filter>/ModelsSet}">
                <core:Item key="{filter>Models}" text="{filter>Models}" />
            </MultiComboBox>

            <Button
            text="Filter"
            icon="sap-icon://filter"
            class="sapUiTinyMarginEnd"
            press="onApplyFilter"/>

        <Button
            text="Clear"
            icon="sap-icon://clear-filter"
            press="onClearFilter"/>


                        <ToolbarSpacer/>
                        <Button
                            text="Create Row"
                            type="Emphasized"
                            icon="sap-icon://add"
                            press="onCreateMasterRow"/>
                    </Toolbar>

                    <Bar ></Bar>
            
                <table:Table
                    id="gmaComponentTable"
                    rows="{/GMAComponentsSet}"
                    visibleRowCount="13"
                    enableBusyIndicator="true"
                    selectionMode="None"
                    width="100%"
                   
                >
                    <table:columns>
                        <!-- ================= BASIC FIELDS ================= -->
                        <table:Column width="150px">
                            <Label text="Model" tooltip="Model" />
                            <table:template>
                                <Input value="{Models}"  editable="{= ${@$ui5.context.isTransient} === true }"
            required="true"  />
                            </table:template>
                        </table:Column>
                        <table:Column width="220px">
                            <Label text="Description" tooltip="Description" />
                            <table:template>
                                <Input value="{Description}" />
                            </table:template>
                        </table:Column>
                     


                         <table:Column width="200px">
                            <Label text="MTS/MTO" tooltip="MTS or MTO Type"/>
                            <table:template>

        <ComboBox
            value="{MtsMto}"
            selectedKey="{MtsMto}"
            width="100%">
            
              <core:Item key="MTS" text="MTS"/>
             <core:Item key="MTO" text="MTO"/>
            

        </ComboBox>
                            </table:template>
                        </table:Column>
                        <table:Column width="180px">
                            <Label text="Reference Model" tooltip="Reference Model"/>
                            <table:template>
                                <Input value="{ReferMtsModel}" />
                            </table:template>
                        </table:Column>

