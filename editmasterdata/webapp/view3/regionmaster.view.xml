<mvc:View
    controllerName="editmasterdata.controller.regionmaster"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true">

        <Page>
    <!-- <customHeader>
                <Toolbar>
                        <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            press="onNavBack" />
                    <ToolbarSpacer/>
                    <Title text="Region Master" level="H2"/>
                    <ToolbarSpacer/>
                </Toolbar>
            </customHeader> -->

<customHeader>
    <Toolbar>

        <!-- Back Button -->
        <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            press="onNavBack" />

        <!-- Royal Enfield Logo -->
        <Image
            src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
            width="130px"
            height="40px"
            class="logoImage"
        />

        <!-- Spacer pushes title to center -->
        <ToolbarSpacer/>

        <!-- Center Title -->
        <Title text="Region Master" class="textHeaderTitle" level="H2"/>

        <!-- Spacer keeps title centered -->
        <ToolbarSpacer/>

    </Toolbar>
</customHeader>


            <!-- TABLE -->
            <content>

<VBox width="100%" alignItems="Center" >



    <Panel width="95%" class="sapUiResponsiveMargin">

    <headerToolbar>
    <Toolbar>

    <Label text="Region" class="sapUiTinyMarginEnd"/>

            <MultiComboBox
                id="filterModelCode"
                width="220px"
                class="sapUiTinyMarginEnd"
                items="{filter>/Region}">
                <core:Item key="{filter>Region}" text="{filter>Region}" />
            </MultiComboBox>

            <Label text="Engine Type" class="sapUiTinyMarginBegin sapUiTinyMarginEnd"/>

            <MultiComboBox
                id="filterEngineType"
                width="180px"
                class="sapUiTinyMarginEnd"
                items="{filter>/EngineType}">
                <core:Item key="{filter>Type}" text="{filter>Type}" />
            </MultiComboBox>

             <Button
            text="Filter"
            icon="sap-icon://filter"
            class="sapUiTinyMarginEnd"
            press="onApplyFilter"/>

        <Button
            text="Clear"
            icon="sap-icon://clear-filter"
            press="onClearFilter"/>


        <ToolbarSpacer/>
        <Button
            text="Create Row"
            icon="sap-icon://add"
            type="Emphasized"
            press="onCreateMasterRow"
            />


            <Button
                        id="excelMenuBtn"
                        text="Excel"
                        icon="sap-icon://excel-attachment"
                        type="Ghost"
                        press="onExcelMenuPress"
                    />
    </Toolbar>
</headerToolbar>

<Bar ></Bar>

        <table:Table
            id="regionTables"
            rows="{/RegionMasterSet}"
            visibleRowCount="13"
            selectionMode="None"
            width="100%"
            enableBusyIndicator="true">

            <table:columns>

                <!-- <table:Column>
                    <Label text="Region"/>
                    <table:template>
                        <Input value="{Region}"/>
                    </table:template>
                </table:Column> -->

      <table:Column>
    <Label text="Region" tooltip="Region"/>
    <table:template>
        <Input
            value="{Region}"
            editable="{= ${_isNew} === true }"
            required="true"
        />
    </table:template>
</table:Column>

 <table:Column width="150px">
    <Label text="Engine Type" tooltip="Engine Type"/>

    <table:template>
        <Select
            selectedKey="{EngineType}"
          
            width="100%">

            <core:Item key="EV" text="EV"/>
            <core:Item key="ICE" text="ICE"/>

        </Select>
    </table:template>
</table:Column>

                <table:Column>
                    <Label text="Description" tooltip="Description"/>
                    <table:template>
                        <Input value="{Ort01}"  maxLength="40"
            valueLiveUpdate="true"/>
                    </table:template>
                </table:Column>

                   <table:Column>
                    <Label text="Language" tooltip="Language"/>
                    <table:template>
                        <Input value="{Spras}"/>
                    </table:template>
                </table:Column>
 
                <table:Column>
                    <Label text="Basic For RTO" tooltip="Basis For RTO"/>
                    <table:template>
                       <Select
          
            selectedKey="{BasisRto}"
            width="100%">
            
            <core:Item key="EXSHOWROOM" text="EXSHOWROOM"/>
            <core:Item key="BASIC" text="BASIC"/>
        </Select>
                    </table:template>
                </table:Column>                   

    <table:Column width="120px">
                            <Label text="Status" tooltip="Status"/>
                            <table:template>
                                <Text text="{Status}"/>
                            </table:template>
                        </table:Column>

                

                

            </table:columns>
        </table:Table>
    </Panel>
</VBox>
            </content>

            <!-- FOOTER -->
            <footer>
                <OverflowToolbar>
                    <ToolbarSpacer/>
                    <Button
                        text="Submit"
                        type="Emphasized"
                        press="onSubmit"/>
                </OverflowToolbar>
            </footer>

            <Popover
            id="excelPopover"
            placement="Bottom"
            showHeader="false"
            contentWidth="130px"
        >
            <VBox
                class="sapUiSmallMargin"
                width="100%"
            >
                <Button
                    text="Upload"
                    icon="sap-icon://upload-to-cloud"
                    press="onExcelPress"
                    type="Ghost"
                />
                <Button
                    text="Download"
                    icon="sap-icon://download"
                    type="Ghost"
                    press="onExcelDownload"
                />
            </VBox>
        </Popover>

<Dialog
    id="fieldSelectDialog"
    title="Select Fields to Download"
    contentWidth="250px"
>

    <List
        id="fieldList"
        mode="MultiSelect"
        includeItemInSelection="true"
    >

        <StandardListItem title="Region" />
        <StandardListItem title="Description" />
        <StandardListItem title="Language" />
        <StandardListItem title="Basis for RTO" />

    </List>

    <beginButton>
        <Button
            text="Download"
            type="Emphasized"
            press="onDownloadSelectedFields"
        />
    </beginButton>

    <endButton>
        <Button
            text="Cancel"
            press="onCancelDownload"
        />
    </endButton>

</Dialog>

        <HBox visible="true">
            <core:HTML
                id="vpFileInputHTML"
                content="&lt;input type='file' id='vpExcelFileInput' accept='.xlsx,.xls,.csv' style='display:none' /&gt;"
            />
        </HBox>

        </Page>

</mvc:View>
