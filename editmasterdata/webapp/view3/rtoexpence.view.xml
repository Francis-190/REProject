<mvc:View controllerName="editmasterdata.controller.rtoexpence"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <App>
        <Page>
            

            <customHeader>
    <Toolbar>

        <!-- Back Button -->
        <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            press="onNavBack" />

        <!-- Royal Enfield Logo -->
        <Image
            src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
            width="130px"
            height="40px"
            class="logoImage"
        />

        <!-- Spacer pushes title to center -->
        <ToolbarSpacer/>

        <!-- Center Title -->
        <Title text="RTO Expence" class="textHeaderTitle" level="H2"/>

        <!-- Spacer keeps title centered -->
        <ToolbarSpacer/>

    </Toolbar>
</customHeader>
            <!-- TABLE -->
            <content>
                <VBox width="100%" alignItems="Center">
                    <Panel width="95%" class="sapUiResponsiveMargin">
    <headerToolbar>
    <Toolbar>

    <Label text="Model" class="sapUiTinyMarginEnd"/>

            <MultiComboBox
                id="filterModelCode"
                width="220px"
                class="sapUiTinyMarginEnd"
                items="{filter>/RegionCode}">
                <core:Item key="{filter>RegionCode}" text="{filter>RegionCode}" />
            </MultiComboBox>

             <Button
            text="Filter"
            icon="sap-icon://filter"
            class="sapUiTinyMarginEnd"
            press="onApplyFilter"/>

        <Button
            text="Clear"
            icon="sap-icon://clear-filter"
            press="onClearFilter"/>


        <ToolbarSpacer/>
        <Button
            text="Create Row"
            icon="sap-icon://add"
            type="Emphasized"
            press="onCreateMasterRow"
            />
    </Toolbar>
</headerToolbar>

<Bar ></Bar>
                        <table:Table
                            id="RtoExpenceTable"
                            rows="{/RTOExpenseSet}"
                            visibleRowCount="13"
                            selectionMode="Single"
                            width="100%"
                            enableBusyIndicator="true">
                            <table:columns>
                                <table:Column>
                                    <Label text="Region"  tooltip="Region"/>
                                    <table:template>
                                        <Input  value="{path:'RegionCode'}"   editable="{= ${@$ui5.context.isTransient} === true }"
            required="true"/>
                                    </table:template>
                                </table:Column>

                                <table:Column width="150px">
    <Label text="Engine Type" tooltip="Engine Type"/>

    <table:template>
        <Select
            selectedKey="{EngineType}"
          
            width="100%">

            <core:Item key="EV" text="EV"/>
            <core:Item key="ICE" text="ICE"/>

        </Select>
    </table:template>
</table:Column>

                                <table:Column>
                                    <Label text="Slab"  tooltip="Slab"/>
                                    <table:template>
                                        <Input type='Number' value="{path:'Slab', type:'sap.ui.model.odata.type.SByte'}" />
                                    </table:template>
                                </table:Column>

                                <table:Column>
                                    <Label text="Min Range" tooltip="Min Range"/>
                                    <table:template>
                                        <Input type="Number" value="{MinRange}"/>
                                    </table:template>
                                </table:Column>
                                <table:Column>
                                    <Label text="Max Range" tooltip="Max Range"/>
                                    <table:template>
                                        <Input type='Number' value="{MaxRange}"/>
                                    </table:template>
                                </table:Column>
                                <table:Column>
                                    <Label text="Expence" tooltip="Expence"/>
                                    <table:template>
                                        <Input type='Number' value="{Expense}" />
                                    </table:template>
                                </table:Column>
                            </table:columns>
                        </table:Table>
                    </Panel>
                </VBox>
            </content>
            <!-- FOOTER -->
            <footer>
                <OverflowToolbar>
                    <ToolbarSpacer />
                    <Button
                        text="Submit"
                        type="Emphasized"
                        press="onSubmit" />
                </OverflowToolbar>
            </footer>
        </Page>
    </App>
</mvc:View>