<mvc:View controllerName="editmasterdata.controller.rtomaster"
 xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <App>
        <Page>
    <!-- <customHeader>
                <Toolbar>
                        <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            press="onNavBack" />
                    <ToolbarSpacer/>
                    <Title text="RTO MASTER" level="H2"/>
                    <ToolbarSpacer/>
                </Toolbar>
            </customHeader> -->

<customHeader>
    <Toolbar>

        <!-- Back Button -->
        <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            press="onNavBack" />

        <!-- Royal Enfield Logo -->
        <Image
            src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
            width="130px"
            height="40px"
            class="logoImage"
        />

        <!-- Spacer pushes title to center -->
        <ToolbarSpacer/>

        <!-- Center Title -->
        <Title text="RTO Master" class="textHeaderTitle" level="H2"/>

        <!-- Spacer keeps title centered -->
        <ToolbarSpacer/>

    </Toolbar>
</customHeader>

            <!-- TABLE -->
            <content>

<VBox width="100%" alignItems="Center" >



    <Panel width="95%" class="sapUiResponsiveMargin">

    <headerToolbar>
    <Toolbar>
    <Label text="Region" class="sapUiTinyMarginEnd"/>

            <MultiComboBox
                id="filterModelCode"
                width="220px"
                class="sapUiTinyMarginEnd"
                items="{filter>/RegionCode}">
                <core:Item key="{filter>RegionCode}" text="{filter>RegionCode}" />
            </MultiComboBox>

               <Label text="Slap" class="sapUiTinyMarginEnd"/>

            <MultiComboBox
                id="filterModelCode1"
                width="220px"
                class="sapUiTinyMarginEnd"
                items="{filter>/Slab}">
                <core:Item key="{filter>Slab}" text="{filter>Slab}" />
            </MultiComboBox>

             <Button
            text="Filter"
            icon="sap-icon://filter"
            class="sapUiTinyMarginEnd"
            press="onApplyFilter"/>

        <Button
            text="Clear"
            icon="sap-icon://clear-filter"
            press="onClearFilter"/>


        <ToolbarSpacer/>
        <Button
            text="Create Row"
            icon="sap-icon://add"
            press="onCreateMasterRow"
            />
    </Toolbar>
</headerToolbar>

        <table:Table
            id="RtoMaterTable"
            rows="{/RtoMasterSet}"
            visibleRowCount="13"
            selectionMode="None"
            width="100%"
            enableBusyIndicator="true">

            <table:columns>

                <table:Column>
                    <Label text="Region" tooltip="Region"/>
                    <table:template>
                        <Input value="{RegionCode}"  editable="{= ${_isNew} === true }"
            required="true"/>
                    </table:template>
                </table:Column>

                <table:Column>
                    <Label text="Slab" tooltip="Slab"/>
                    <table:template>
                        <Input type="Number" value="{path:'Slab',  type: 'sap.ui.model.type.Integer'}"  editable="{= ${_isNew} === true }"
            required="true"/>
                    </table:template>
                </table:Column>

                 <table:Column width="150px">
    <Label text="Engine Type" tooltip="Engine Type"/>

    <table:template>
        <Select
            selectedKey="{EngineType}"
          
            width="100%">

            <core:Item key="EV" text="EV"/>
            <core:Item key="ICE" text="ICE"/>

        </Select>
    </table:template>
</table:Column>

                <table:Column>
                    <Label text="CC Min" tooltip="CC Min"/>
                    <table:template>
                         <Input type="Number" value="{CcMin}" 
            required="true"/>
                    </table:template>
                </table:Column>

                <table:Column>
                    <Label text="CC Max" tooltip="CC Max"/>
                    <table:template>
                        <Input type="Number" value="{CcMax}" 
            required="true"/>
                    </table:template>
                </table:Column>

                <table:Column>
                    <Label text="Min Range" tooltip="Min Range"/>
                    <table:template>
                        <Input type="Number" value="{MinRange}"/>
                    </table:template>
                </table:Column>

                <table:Column>
                    <Label text="Max Ranges" tooltip="Max Ranges"/>
                    <table:template>
                        <Input type="Number" value="{MaxRange}"/>
                    </table:template>
                </table:Column>

                <table:Column>
                    <Label text="RTO %" tooltip="RTO %"/>
                    <table:template>
                        <Input type="Number" value="{RtoPercent}"/>
                    </table:template>
                </table:Column>

                <table:Column>
                    <Label text="RTO Value" tooltip="RTO Value"/>
                    <table:template>
                        <Input  type="Number" value="{PriceValue}"/>
                    </table:template>
                </table:Column>
            </table:columns>
        </table:Table>
    </Panel>
</VBox>




            </content>

            <!-- FOOTER -->
            <footer>
                <OverflowToolbar>
                    <ToolbarSpacer/>
                    <Button
                        text="Submit"
                        type="Emphasized"
                        press="onSubmit"/>
                </OverflowToolbar>
            </footer>

        </Page>
    </App>
</mvc:View>
