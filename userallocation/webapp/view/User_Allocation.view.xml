<mvc:View
    controllerName="userallocation.controller.User_Allocation"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    displayBlock="true"
>
    <Page showHeader="true">
        <!-- ═══ HEADER ═══ -->
        <customHeader>
            <Toolbar>
                <Image
                    src="https://www.royalenfield.com/content/dam/royal-enfield/india/logos/logo.svg"
                    width="130px"
                    height="40px"
                    class="logoImage"
                />
                <ToolbarSpacer />
                <Title
                    class="header"
                    text="User Details &amp; Roles"
                    level="H2"
                />
                <ToolbarSpacer />
            </Toolbar>
        </customHeader>

        <!-- ═══ CONTENT ═══ -->
        <content>
            <VBox
                width="100%"
                class="sapUiMediumMarginTop"
            >
                <!-- Page Title -->
                <VBox
                    class="sapUiLargeMarginBegin sapUiLargeMarginEnd sapUiSmallMarginBottom"
                >
                    <Title
                        text="User Details &amp; Roles"
                        level="H2"
                        titleStyle="H2"
                    />
                    <Text
                        text="Manage access levels and email assignments"
                        class="sapUiSmallMarginTop"
                    />
                </VBox>

                <Panel
                    width="auto"
                    class="sapUiLargeMarginBegin sapUiLargeMarginEnd sapUiShadowMedium"
                    expandable="false"
                >
                    <headerToolbar>
                        <Toolbar>
                            <Title
                                text="User Records"
                                level="H5"
                                titleStyle="H5"
                            />
                            <ObjectStatus
                                text="{= ${/ApproverSet}.length + ' rows'}"
                                state="None"
                                class="sapUiSmallMarginBegin"
                            />
                            <ToolbarSpacer />
                            <Button
                                text="Add Row"
                                icon="sap-icon://add"
                                type="Default"
                                press="onCreateMasterRow"
                            />
                        </Toolbar>
                    </headerToolbar>

                    <table:Table
                        id="UserTables"
                        rows="{/ApproverSet}"
                        visibleRowCount="10"
                        selectionMode="None"
                        alternateRowColors="true"
                        enableBusyIndicator="true"
                        noDataText="No users added yet. Click 'Add Row' to get started."
                        width="100%"
                    >
                        <table:extension>
                            <Toolbar>
                                <ToolbarSpacer />
                                <Button
                                    icon="sap-icon://refresh"
                                    tooltip="Refresh"
                                    press="onRefresh"
                                    type="Transparent"
                                />
                            </Toolbar>
                        </table:extension>

                        <table:columns>
                            <!-- Mail ID -->
                            <table:Column
                                width="50%"
                                minWidth="160"
                            >
                                <Label text="Mail ID" />
                                <table:template>
                                    <Input
                                        value="{Mail}"
                                        placeholder="user@royalenfield.com"
                                        valueLiveUpdate="true"
                                        type="Email"
                                        showValueStateMessage="true"
                                        valueState="{
                                            path: 'Mail',
                                            formatter: '.formatMailValueState'
                                        }"
                                        valueStateText="Enter a valid email address"
                                        width="100%"
                                    />
                                </table:template>
                            </table:Column>

                            <!-- Role -->
                            <table:Column width="180px">
                                <Label text="Role" />
                                <table:template>
                                    <Select
                                        selectedKey="{Role}"
                                        width="100%"
                                        change="onRoleChange"
                                    >
                                        <!-- <items>
                                            <core:Item key="APPROVER" text="Approver" />
                                            <core:Item key="SUBMITTER" text="Submitter" />
                                        </items> -->

                                        <items>
                                            <core:Item
                                                key="APPROVER1"
                                                text="Approver 1"
                                            />
                                            <core:Item
                                                key="APPROVER2"
                                                text="Approver 2"
                                            />
                                            <core:Item
                                                key="APPROVER"
                                                text="Master Data Approver"
                                            />
                                            <core:Item
                                                key="SUBMITTER"
                                                text="Submitter "
                                            />
                                        </items>
                                    </Select>
                                </table:template>
                            </table:Column>

                            <!-- Role Badge (display only) -->
                            <table:Column width="130px">
                                <Label text="Status" />
                                <table:template>
                                    <!-- <ObjectStatus
                                        text="{
                                            path: 'Role',
                                            formatter: '.formatRoleText'
                                        }"
                                        state="{
                                            path: 'Role',
                                            formatter: '.formatRoleState'
                                        }"
                                        inverted="true"
                                        icon="{
                                            path: 'Role',
                                            formatter: '.formatRoleIcon'
                                        }"
                                    /> -->

                                    <ObjectStatus
    text="{ path: 'Role', formatter: '.formatRoleText' }"
    icon="{ path: 'Role', formatter: '.formatRoleIcon' }"
    state="None"
    class="roleChip">
    <customData>
        <core:CustomData key="role" value="{Role}" writeToDom="true" />
    </customData>
</ObjectStatus>
                                </table:template>
                            </table:Column>
                        </table:columns>
                    </table:Table>
                </Panel>
            </VBox>
        </content>

        <!-- ═══ FOOTER ═══ -->
        <footer>
            <OverflowToolbar>
                <Button
                    text="Clear All"
                    type="Default"
                    icon="sap-icon://delete"
                    press="onClearAll"
                />
                <ToolbarSpacer />
                <Button
                    text="Cancel"
                    type="Default"
                    press="onCancel"
                />
                <Button
                    text="Submit"
                    type="Emphasized"
                    icon="sap-icon://paper-plane"
                    press="onSubmit"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
