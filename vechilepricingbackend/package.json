{
  "name": "vechilepricingbackend",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^4.4.0",
    "@sap-cloud-sdk/http-client": "^4.4.0",
    "@sap-cloud-sdk/odata-v2": "^4.4.0",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^9",
    "@sap/cds-odata-v2-adapter-proxy": "^1.9.21",
    "@sap/xssec": "^4",
    "better-sqlite3": "^13.0.1",
    "cors": "^2.8.6",
    "express": "^4",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-vechilepricingautomation": "cds watch --open vechilepricingautomation/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "server": {
      "index": true
    },
    "requires": {
      "vechilePricing": {
        "kind": "odata-v2",
        "model": "srv/external/vechilePricing",
        "credentials": {
          "destination": "SAP_QRE_900",
          "path": "/sap/opu/odata/sap/ZSD_VEH_PRIC_AUTOMATION_SRV",
          "csrf": true
        }
      },
      "[production]": {
        "auth": "mocked"
      },
      "destinations": true
    }
  },
  "workspaces": [
    "app/*"
  ]
}
