{
  "_version": "1.81.0",
  "sap.app": {
    "id": "vehiclepricingui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.20.2",
      "toolsId": "81fc8e8e-ef39-4286-a0d6-b941e05ae961"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/vechileprocing-apis/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "vehiclepricing-vehiclepricing": {
          "semanticObject": "vehiclepricing",
          "action": "vehiclepricing",
          "icon": "sap-icon://workflow-tasks",
          "title": "{{vehiclepricing-vehiclepricing.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        },
        "vehicleautomation-vehicleautomation": {
          "semanticObject": "vehicleautomation",
          "action": "vehicleautomation",
          "icon": "sap-icon://tags",
          "title": "{{vehicleautomation-vehicleautomation.flpTitle}}",
          "subTitle": "{{vehicleautomation-vehicleautomation.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.145.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "vehiclepricingui.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupId": "$auto"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ],
      "js": [
        {
          "uri": "libs/xlsx.full.min.js"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "vehiclepricingui.view",
        "async": true,
        "viewPath": "vehiclepricingui.view"
      },
      "routes": [
        {
          "name": "vehcileapproval",
          "pattern": "vehcileapproval",
          "target": [
            "vehcileapproval"
          ]
        },
        {
          "name": "vechilepricingmain",
          "pattern": "vechilepricingmain",
          "target": [
            "vechilepricingmain"
          ]
        },
        {
          "name": "vehcileapprovaldetail",
          "pattern": "vehcileapprovaldetail/{ref}",
          "target": [
            "vehcileapprovaldetail"
          ]
        },
        {
          "name": "approverList",
          "pattern": "approverList",
          "target": [
            "approverList"
          ]
        },
        {
          "pattern": "noAccess",
          "name": "noAccess",
          "target": "noAccess"
        },
        {
          "pattern": "home",
          "name": "home",
          "target": "home"
        }
      ],
      "targets": {
        "home": {
          "viewName": "Home",
          "viewType": "XML"
        },
        "noAccess": {
          "viewName": "NoAccess",
          "viewType": "XML"
        },
        "vehcileapproval": {
          "id": "vehcileapproval",
          "name": "vehcileapproval"
        },
        "vechilepricingmain": {
          "id": "vechilepricingmain",
          "name": "vechilepricingmain"
        },
        "vehcileapprovaldetail": {
          "id": "vehcileapprovaldetail",
          "name": "vehcileapprovaldetail"
        },
        "approverList": {
          "id": "ApproverList",
          "name": "ApproverList"
        }
      }
    },
    "rootView": {
      "viewName": "vehiclepricingui.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "vehiclepricingui"
  }
}