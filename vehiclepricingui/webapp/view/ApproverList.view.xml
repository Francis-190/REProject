<mvc:View
    controllerName="vehiclepricingui.controller.ApproverList"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <App id="app">

        <Page
            id="approverPage"
            showHeader="false"
            class="approverPage">

            <content>

                <VBox
                    class="approverMain"
                    alignItems="Center">

                    <!-- HEADER -->
                    <VBox
                        alignItems="Center"
                        class="approverHeader">

                        <Text
                            text="APPROVER MANAGEMENT"
                            class="approverEyebrow"/>

                        <Title
                            text="Approval Levels"
                            level="H1"
                            class="approverMainTitle"/>

                        <Text
                            text="Select an approval level to manage the configured approvers."
                            class="approverSubtitle"/>

                    </VBox>


                    <!-- APPROVER CARDS -->
                    <HBox
                        alignItems="Center"
                        justifyContent="Center"
                        class="approverCards">


                        <!-- L1 CARD -->
                        <CustomListItem
                            type="Active"
                            class="roleCard l1RoleCard"
                            press=".onL1ApproverPress">

                            <VBox
                                alignItems="Center">

                                <VBox
                                    alignItems="Center"
                                    class="roleIcon l1RoleIcon">

                                    <core:Icon
                                        src="sap-icon://employee"
                                        size="4rem"/>

                                </VBox>

                                <Text
                                    text="LEVEL 01"
                                    class="roleLevel l1Level"/>

                                <Title
                                    text="L1 Approver"
                                    level="H3"
                                    />

                                <Text
                                    text="First Level Approval"
                                    class="roleDescription"/>

                                <HBox
                                    alignItems="Center"
                                    justifyContent="Center"
                                    class="roleAction">

                                    <Text
                                        text="Manage L1 Approvers"
                                        class="roleActionText"/>

                                    <core:Icon
                                        src="sap-icon://navigation-right-arrow"
                                        size="0.9rem"
                                        class="roleArrow l1Arrow"/>

                                </HBox>

                            </VBox>

                        </CustomListItem>


                        <!-- L2 CARD -->
                        <CustomListItem
                            type="Active"
                            class="roleCard l2RoleCard"
                            press=".onL2ApproverPress">

                            <VBox
                                alignItems="Center">

                                <VBox
                                    alignItems="Center"
                                    class="roleIcon l2RoleIcon">

                                    <core:Icon
                                        src="sap-icon://group"
                                        size="4rem"/>

                                </VBox>

                                <Text
                                    text="LEVEL 02"
                                    class="roleLevel l2Level"/>

                                <Title
                                    text="L2 Approver"
                                    level="H2"
                                    />

                                <Text
                                    text="Second Level Approval"
                                    class="roleDescription"/>

                                <HBox
                                    alignItems="Center"
                                    justifyContent="Center"
                                    class="roleAction">

                                    <Text
                                        text="Manage L2 Approvers"
                                        class="roleActionText"/>

                                    <core:Icon
                                        src="sap-icon://navigation-right-arrow"
                                        size="0.9rem"
                                        class="roleArrow l2Arrow"/>

                                </HBox>

                            </VBox>

                        </CustomListItem>

                    </HBox>


                    <Text
                        text="Choose a level to view and manage its approvers."
                        class="approverFooter"/>

                </VBox>

            </content>

        </Page>

    </App>

</mvc:View>