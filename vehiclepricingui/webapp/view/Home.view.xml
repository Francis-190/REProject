<mvc:View
    controllerName="vehiclepricingui.controller.Home"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="HomePage"
        showHeader="false"
        class="vehiclePricingPage">

        <content>
        <VBox class="homeWrapper">

            <VBox
                id="heroSection"
                class="heroSection">

                <!-- Hero Content -->
                <VBox
                    id="heroContent"
                    class="heroContent">

                    <Text
                        text="WELCOME TO"
                        class="welcomeText" />

                    <Title
                        text="Vehicle Pricing"
                        level="H1"
                        class="heroTitle" />

                    <!-- Blue underline -->
                    <HBox
                        class="titleUnderline" />

                    <Text
                        text="Manage vehicle pricing submissions, reviews and approvals efficiently in one place."
                        class="heroDescription" />


                    <List
                        id="actionCards"
                        class="actionCards"
                        showSeparators="None">


                        <CustomListItem
                            id="pricingSubmissionCard"
                            class="actionCard submissionCard"
                            type="Active"
                            press=".onPricingTilePress">

                            <HBox
                                width="100%"
                                height="100%"
                                alignItems="Center"
                                justifyContent="SpaceBetween">

                                <!-- Left side -->
                                <HBox
                                    alignItems="Center">

                                    <!-- Icon -->
                                    <VBox
                                        class="actionIconContainer submissionIcon">

                                        <core:Icon
                                            src="sap-icon://money-bills"
                                            class="actionIcon" />

                                    </VBox>


                                    <!-- Text -->
                                    <VBox
                                        class="actionText">

                                        <Title
                                            text="Pricing Submission"
                                            level="H4"
                                            class="actionTitle" />

                                        <Text
                                            text="Create and submit vehicle pricing"
                                            class="actionDescription" />

                                    </VBox>

                                </HBox>


                                <!-- Arrow -->
                                <core:Icon
                                    src="sap-icon://navigation-right-arrow"
                                    class="arrowIcon submissionArrow" />

                            </HBox>

                        </CustomListItem>


                        <CustomListItem
                            id="pricingApprovalCard"
                            class="actionCard approvalCard"
                            type="Active"
                            press=".onApprovalTilePress">

                            <HBox
                                width="100%"
                                height="100%"
                                alignItems="Center"
                                justifyContent="SpaceBetween">

                                <!-- Left side -->
                                <HBox
                                    alignItems="Center">

                                    <!-- Icon -->
                                    <VBox
                                        class="actionIconContainer approvalIcon">

                                        <core:Icon
                                            src="sap-icon://approvals"
                                            class="actionIcon" />

                                    </VBox>


                                    <!-- Text -->
                                    <VBox
                                        class="actionText">

                                        <Title
                                            text="Pricing Approvals"
                                            level="H4"
                                            class="actionTitle" />

                                        <Text
                                            text="Review and approve submitted pricing"
                                            class="actionDescription" />

                                    </VBox>

                                </HBox>


                                <!-- Arrow -->
                                <core:Icon
                                    src="sap-icon://navigation-right-arrow"
                                    class="arrowIcon approvalArrow" />

                            </HBox>

                        </CustomListItem>

                    </List>

                </VBox>


                <!-- <VBox
                    id="bikeSection"
                    class="bikeSection">

                    <Image
                        id="meteorBike"
                        decorative="false"
                        src="./images/vehicle_pricing_UI_bike_background.jpg.png"
                        alt="Royal Enfield Meteor 350"
                        class="meteorBike" 
                        />

                </VBox> -->

            </VBox> 


            <HBox
                id="featuresSection"
                class="featuresSection"
                justifyContent="SpaceAround"
                alignItems="Center">

                <HBox
                    class="featureItem"
                    alignItems="Center">

                    <VBox
                        class="featureIcon blueFeature">

                        <core:Icon
                            src="sap-icon://shield"
                            class="featureIconImage" />

                    </VBox>

                    <VBox>

                        <Title
                            text="Accurate Pricing"
                            level="H5"
                            class="featureTitle" />

                        <Text
                            text="Ensure accurate and consistent pricing"
                            class="featureDescription" />

                    </VBox>

                </HBox>


                <!-- Divider -->

                <VBox
                    class="featureDivider" />

                <HBox
                    class="featureItem"
                    alignItems="Center">

                    <VBox
                        class="featureIcon greenFeature">

                        <core:Icon
                            src="sap-icon://approvals"
                            class="featureIconImage" />

                    </VBox>

                    <VBox>

                        <Title
                            text="Easy Approvals"
                            level="H5"
                            class="featureTitle" />

                        <Text
                            text="Streamline review and approval process"
                            class="featureDescription" />

                    </VBox>

                </HBox>


                <!-- Divider -->

                <VBox
                    class="featureDivider" />


                <HBox
                    class="featureItem"
                    alignItems="Center">

                    <VBox
                        class="featureIcon orangeFeature">

                        <core:Icon
                            src="sap-icon://business-objects-experience"
                            class="featureIconImage" />

                    </VBox>

                    <VBox>

                        <Title
                            text="Real-time Insights"
                            level="H5"
                            class="featureTitle" />

                        <Text
                            text="Get real-time visibility and reports"
                            class="featureDescription" />

                    </VBox>

                </HBox>


                <!-- Divider -->

                <VBox
                    class="featureDivider" />



                <HBox
                    class="featureItem"
                    alignItems="Center">

                    <VBox
                        class="featureIcon purpleFeature">

                        <core:Icon
                            src="sap-icon://locked"
                            class="featureIconImage" />

                    </VBox>

                    <VBox>

                        <Title
                            text="Secure Access"
                            level="H5"
                            class="featureTitle" />

                        <Text
                            text="Role-based access and data security"
                            class="featureDescription" />

                    </VBox>

                </HBox>

            </HBox>

            </VBox>


        </content>

    </Page>

</mvc:View>