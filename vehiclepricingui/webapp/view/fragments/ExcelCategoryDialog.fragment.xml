<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">

<Dialog id="fieldSelectDialog" title="Select Fields to Download">
    <VBox class="sapUiSmallMargin">

        <MultiComboBox
            id="fieldSelector"
            width="100%"
        >
            <core:Item key="Region" text="Region"/>
            <core:Item key="Ort01" text="Description"/>
            <core:Item key="Spras" text="Language"/>
            <core:Item key="BasisRto" text="Basis for RTO"/>
        </MultiComboBox>

    </VBox>

    <beginButton>
        <Button
            text="Download"
            type="Emphasized"
            press="onDownloadSelectedFields"
        />
    </beginButton>

    <endButton>
        <Button
            text="Cancel"
            press="onCancelDownload"
        />
    </endButton>

</Dialog>

</core:FragmentDefinition>