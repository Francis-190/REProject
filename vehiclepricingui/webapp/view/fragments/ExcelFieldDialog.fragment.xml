<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

<Dialog
    id="excelFieldDialog"
    title="Select Fields">

<List
    id="excelFieldList"
    mode="MultiSelect"
    items="{/columns}">

    <StandardListItem
        title="{label}" />

</List>

<beginButton>
<Button
    text="Download"
    type="Emphasized"
    press="onConfirmExcelDownload"/>
</beginButton>

<endButton>
<Button
    text="Cancel"
    press="onCloseExcelDialog"/>
</endButton>

</Dialog>

</core:FragmentDefinition>