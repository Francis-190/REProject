<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog id="postPriceDialog" title="Update to SAP" contentWidth="420px"
            stretch="{device>/system/phone}">
        <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout"
                          labelSpanM="12" labelSpanL="12" labelSpanXL="12">
                <f:content>
                    <!-- MTO / MTS -->
                    <Label text="Stock Transfer Date" required="true" visible="{pp>/showMtoMts}"/>
                    <DatePicker value="{pp>/StockTransferDate}" valueFormat="yyyy-MM-dd"
                                displayFormat="dd MMM yyyy" visible="{pp>/showMtoMts}" minDate="{view>/minDate}"
                                valueState="{pp>/errStock}"/>

                    <Label text="Dealer Billing Date" required="true" visible="{pp>/showMtoMts}"/>
                    <DatePicker value="{pp>/DealerBillingDate}" valueFormat="yyyy-MM-dd"
                                displayFormat="dd MMM yyyy" visible="{pp>/showMtoMts}" minDate="{view>/minDate}"
                                valueState="{pp>/errDealer}"/>

                    <Label text="Customer Billing Date" required="true" visible="{pp>/showMtoMts}"/>
                    <DatePicker value="{pp>/CustomerBillingDate}" valueFormat="yyyy-MM-dd"
                                displayFormat="dd MMM yyyy" visible="{pp>/showMtoMts}" minDate="{view>/minDate}"
                                valueState="{pp>/errCustomer}"/>

                    <!-- CSD -->
                    <Label text="CSD Date" required="true" visible="{pp>/showCsd}"/>
                    <DatePicker value="{pp>/CsdDate}" valueFormat="yyyy-MM-dd"
                                displayFormat="dd MMM yyyy" visible="{pp>/showCsd}" minDate="{view>/minDate}"
                                valueState="{pp>/errCsd}"/>

                    <!-- GEM -->
                    <Label text="GEM Date" required="true" visible="{pp>/showGem}"/>
                    <DatePicker value="{pp>/GemDate}" valueFormat="yyyy-MM-dd"
                                displayFormat="dd MMM yyyy" visible="{pp>/showGem}" minDate="{view>/minDate}"
                                valueState="{pp>/errGem}"/>

                    <!-- read-only audit info -->
                    <Label text="Updated By"/>
                    <Text text="{pp>/UpdatedByName}"/>
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button text="Update" type="Emphasized" press=".onPostPriceConfirm"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onPostPriceCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>