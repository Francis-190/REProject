<mvc:View
    controllerName="vehiclepricingui.controller.vehcileapproval"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <f:DynamicPage
        id="submissionPage"
        headerExpanded="true"
        toggleHeaderOnTitleClick="true"
        fitContent="true">

        <!-- ═══════════════════════════ TITLE ═══════════════════════════ -->
        <f:title>
            <f:DynamicPageTitle>

                <f:heading>
                    <HBox
                        alignItems="Center"
                        justifyContent="SpaceBetween"
                        width="100%"
                        renderType="Bare">

                        <HBox
                            justifyContent="Center"
                            alignItems="Center"
                            renderType="Bare"
                            class="sapUiFlexGrow1">
                            <Title
                                text="Submission References"
                                level="H2"
                                titleStyle="H2"
                                textAlign="Center"/>
                        </HBox>

                        <HBox width="8rem"/>
                    </HBox>
                </f:heading>

                <f:snappedHeading>
                    <HBox
                        alignItems="Center"
                        justifyContent="SpaceBetween"
                        width="100%"
                        renderType="Bare">

                        <HBox width="7rem" alignItems="Center">
                            <Image
                                src="images/Royal-Enfield-logo.png"
                                height="2rem"
                                decorative="true"/>
                        </HBox>

                        <HBox
                            justifyContent="Center"
                            alignItems="Center"
                            renderType="Bare"
                            class="sapUiFlexGrow1">
                            <Title
                                text="Submission References"
                                level="H3"
                                titleStyle="H3"
                                textAlign="Center"/>
                        </HBox>

                        <HBox width="7rem"/>
                    </HBox>
                </f:snappedHeading>

                <f:navigationActions>
                    <OverflowToolbarButton
                        icon="sap-icon://nav-back"
                        text="Back"
                        press=".onNavBack"/>
                </f:navigationActions>

            </f:DynamicPageTitle>
        </f:title>

        <!-- ═══════════════════════════ CONTENT ═══════════════════════════ -->
        <f:content>
            <VBox class="sapUiResponsivePadding--header sapUiResponsivePadding--content">

                <!-- ── Filter Tabs ───────────────────────────────────── -->
                <IconTabBar
                    id="idFilterBar"
                    select=".onFilterSelect"
                    expandable="false"
                    stretchContentHeight="false"
                    class="sapUiSmallMarginBottom">
                    <items>
                        <IconTabFilter key="ALL"       text="All"/>
                        <IconTabFilter key="SUBMITTED" text="Submitted"/>
                        <IconTabFilter key="APPROVED"  text="Approved"/>
                        <IconTabFilter key="REJECTED"  text="Rejected"/>
                    </items>
                </IconTabBar>

                <!-- ── Table ─────────────────────────────────────────── -->
                <Table
                    id="submissionTable"
                    inset="false"
                    growing="true"
                    growingThreshold="15"
                    growingScrollToLoad="true"
                    alternateRowColors="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    mode="None"
                    noDataText="No submission references found"
                    items="{
                        path: 'vm>/filteredData',
                        sorter: { path: 'CreatedOn', descending: true }
                    }">

                    <headerToolbar>
                        <Toolbar>
                            <Title text="References" level="H4"/>
                            <ToolbarSpacer/>
                            <SearchField
                                id="searchField"
                                placeholder="Search..."
                                liveChange=".onSearch"
                                width="16rem"/>
                        </Toolbar>
                    </headerToolbar>

                    <columns>
                        <Column width="14rem" importance="High">
                            <Text text="Reference Number"/>
                        </Column>
                        <Column width="9rem" importance="High">
                            <Text text="Status"/>
                        </Column>
                        <Column
                            width="12rem"
                            minScreenWidth="Phone"
                            demandPopin="true"
                            importance="High">
                            <Text text="Comments"/>
                        </Column>
                        <Column
                            width="11rem"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            importance="Medium">
                            <Text text="Created On"/>
                        </Column>
                        <Column
                            width="10rem"
                            minScreenWidth="Desktop"
                            demandPopin="true"
                            importance="Low">
                            <Text text="Created By"/>
                        </Column>
                        <Column
                            width="11rem"
                            minScreenWidth="Desktop"
                            demandPopin="true"
                            importance="Low">
                            <Text text="Status Changed On"/>
                        </Column>
                        <Column
                            width="10rem"
                            minScreenWidth="Desktop"
                            demandPopin="true"
                            importance="Low">
                            <Text text="Status Changed By"/>
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem
                            type="Navigation"
                            press=".onReferencePress"
                            highlight="{=
                                ${vm>Status} === 'APPROVED' ? 'Success' :
                                ${vm>Status} === 'REJECTED' ? 'Error'   : 'Warning'
                            }">
                            <cells>

                                <!-- Reference Number — NO press on Link, row handles it -->
                                <HBox alignItems="Center">
                                    <core:Icon
                                        src="sap-icon://document-text"
                                        size="1rem"
                                        color="@sapUiHighlight"
                                        class="sapUiTinyMarginEnd"/>
                                    <Link
                                        text="{vm>ReferenceNum}"
                                        subtle="false"
                                        wrapping="false"/>
                                </HBox>

                                <!-- Status -->
                                <ObjectStatus
                                    text="{vm>Status}"
                                    state="{=
                                        ${vm>Status} === 'APPROVED' ? 'Success' :
                                        ${vm>Status} === 'REJECTED' ? 'Error'   : 'Warning'
                                    }"
                                    icon="{=
                                        ${vm>Status} === 'APPROVED' ? 'sap-icon://accept'  :
                                        ${vm>Status} === 'REJECTED' ? 'sap-icon://decline' : 'sap-icon://pending'
                                    }"
                                    inverted="false"/>

                                <!-- Comments -->
                                <Text
                                    text="{vm>Comments}"
                                    wrapping="false"
                                    maxLines="1"
                                    tooltip="{vm>Comments}"/>

                                <!-- Created On -->
                                <Text text="{
                                    path: 'vm>CreatedOn',
                                    type: 'sap.ui.model.type.DateTime',
                                    formatOptions: { pattern: 'MMM dd, yyyy' }
                                }"/>

                                <!-- Created By -->
                                <HBox alignItems="Center">
                                    <Avatar
                                        initials="{=
                                            ${vm>CreatedBy}
                                                ? ${vm>CreatedBy}.charAt(0).toUpperCase()
                                                : '?'
                                        }"
                                        displaySize="XS"
                                        backgroundColor="Accent6"
                                        tooltip="{vm>CreatedBy}"
                                        class="sapUiTinyMarginEnd"/>
                                    <Text text="{vm>CreatedBy}"/>
                                </HBox>

                                <!-- Status Changed On -->
                                <Text text="{
                                    path: 'vm>StatChangedOn',
                                    type: 'sap.ui.model.type.DateTime',
                                    formatOptions: { pattern: 'MMM dd, yyyy' }
                                }"/>

                                <!-- Status Changed By -->
                                <HBox alignItems="Center">
                                    <Avatar
                                        initials="{=
                                            ${vm>StatChangedBy}
                                                ? ${vm>StatChangedBy}.charAt(0).toUpperCase()
                                                : '?'
                                        }"
                                        displaySize="XS"
                                        backgroundColor="Accent2"
                                        tooltip="{vm>StatChangedBy}"
                                        class="sapUiTinyMarginEnd"/>
                                    <Text text="{vm>StatChangedBy}"/>
                                </HBox>

                            </cells>
                        </ColumnListItem>
                    </items>

                </Table>
            </VBox>
        </f:content>

    </f:DynamicPage>
</mvc:View>